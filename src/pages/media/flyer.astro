---
import QRCode from "qrcode";
import { Image } from "astro:assets";
import LogoTitle from "../../components/icons/LogoTitle.astro";
import BatteryIcon from "../../components/icons/BatteryIcon.astro";
import CarIcon from "../../components/icons/CarIcon.astro";
import CpuChipIcon from "../../components/icons/CpuChipIcon.astro";
import HomeModernIcon from "../../components/icons/HomeModernIcon.astro";
import CheckBadgeIcon from "../../components/icons/CheckBadgeIcon.astro";
import PhoneIcon from "../../components/icons/PhoneIcon.astro";
import EnvelopeIcon from "../../components/icons/EnvelopeIcon.astro";
import alexImg from "../../assets/images/alex.png";
import heroRightImg from "../../assets/images/hero/hero-right.JPG";
import "../../styles/global.css";

// Generera högupplöst QR-kod (300 DPI Data URL för felfri och skarp utskrift)
const qrUrl = "https://elprojekt.nu/qr?src=flyer";
const qrDataUrl = await QRCode.toDataURL(qrUrl, {
    width: 320,
    margin: 1,
    color: {
        dark: "#002a75",
        light: "#ffffff"
    }
});
---

<!doctype html>
<html lang="sv">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELPROJEKT - A4 Flyer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Exact A4 Print Configuration */
        @page {
            size: A4 portrait;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        /* Screen Preview */
        @media screen {
            body {
                background-color: #1e293b;
                padding: 30px 10px;
                display: flex;
                flex-direction: column;
                align-items: center;
                min-height: 100vh;
            }
            .flyer-page {
                width: 210mm;
                height: 297mm;
                max-height: 297mm;
                background: #ffffff;
                box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);
                position: relative;
                overflow: hidden;
            }
        }

        /* Print Execution */
        @media print {
            html, body {
                width: 210mm !important;
                height: 297mm !important;
                max-width: 210mm !important;
                max-height: 297mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            .flyer-page {
                width: 210mm !important;
                height: 297mm !important;
                max-height: 297mm !important;
                margin: 0 !important;
                padding: 10mm 12mm !important;
                box-shadow: none !important;
                border: none !important;
                overflow: hidden !important;
                page-break-after: avoid !important;
                page-break-before: avoid !important;
                page-break-inside: avoid !important;
            }
        }

        .font-display {
            font-family: 'Bank Gothic Light', 'Inter', sans-serif;
        }
    </style>
</head>
<body>
    <!-- On-screen preview toolbar -->
    <div class="no-print mb-4 flex flex-wrap gap-4 items-center justify-between max-w-[210mm] w-full bg-slate-900 text-white px-5 py-3 rounded-xl shadow-xl border border-slate-700">
        <div>
            <h1 class="text-sm font-bold font-display tracking-wide text-white">ELPROJEKT – Tryckfärdig A4 Flyer</h1>
            <p class="text-[11px] text-slate-300">Format: A4 (210 × 297 mm) • Skala 100% • Bakgrundsgrafik på</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="bg-elorange hover:bg-orange-600 text-white font-bold px-4 py-2 rounded-lg text-xs transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                Skriv ut / Spara PDF
            </button>
            <a href="/media" class="bg-slate-800 hover:bg-slate-700 text-slate-100 hover:text-white font-semibold px-4 py-2 rounded-lg text-xs transition-all border border-slate-600 flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 text-elorange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Tillbaka till Mediebanken
            </a>
        </div>
    </div>

    <!-- FLYER A4 PAGE -->
    <div class="flyer-page flex flex-col justify-between p-[10mm_12mm] text-slate-800 relative select-none bg-white">

        <!-- 1. RUBRIK & INLEDNING (Högst upp) -->
        <header class="flex flex-col gap-2.5">
            <!-- Header Top Bar: Centrerad och större logotyp -->
            <div class="flex items-center justify-center border-b border-slate-200/80 pb-2">
                <div class="w-[235px]">
                    <LogoTitle className="w-full h-auto text-elblue" />
                </div>
            </div>

            <!-- Hero Inledning -->
            <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white rounded-xl p-4 shadow-sm border border-slate-800 relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-elorange/20 rounded-full blur-xl pointer-events-none"></div>
                <div class="relative z-10">
                    <span class="text-elorange font-display text-[10px] font-bold uppercase tracking-widest block mb-0.5">
                        Din personliga elektriker
                    </span>
                    <h1 class="text-[19px] font-display font-extrabold leading-tight text-white mb-1.5">
                        Allt inom el – <span class="text-elorange">Tryggt, modernt och personligt.</span>
                    </h1>
                    <p class="text-[11.5px] leading-relaxed text-slate-200 font-sans">
                        Jag finns vid din sida genom hela projektet – från första idén till färdig installation. Oavsett om du behöver en laddbox, renovera badrummet eller bygga nytt, får du en trygg installation med personlig service.
                    </p>
                </div>
            </div>
        </header>

        <!-- 2. VÅRA TJÄNSTER (Kvadratiska 1:1 bildkort utan ikoner/badges, med mjuk botten-gradient) -->
        <section class="my-1">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-1.5">
                    <CheckBadgeIcon className="w-4 h-4 text-elorange flex-shrink-0" />
                    <h2 class="text-[12px] font-display font-extrabold text-elblue uppercase tracking-wider">
                        Våra Tjänster
                    </h2>
                </div>
                <span class="text-[9.5px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                    Tydliga offerter med fasta priser
                </span>
            </div>

            <div class="grid grid-cols-2 gap-2.5">
                <!-- Tjänst 1: Solenergi & Batterilagring -->
                <div class="relative w-full aspect-square max-h-[65mm] rounded-xl overflow-hidden shadow-sm border border-slate-200">
                    <img 
                        src="https://images.unsplash.com/photo-1730807908064-c087959dd52c?auto=format&fit=crop&q=80&w=800" 
                        alt="Solceller & Batterilagring" 
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <!-- Mjuk botten-gradient endast bakom texten -->
                    <div class="absolute inset-x-0 bottom-0 h-[48%] bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent flex flex-col justify-end p-3">
                        <h3 class="font-bold text-[12px] text-white font-display leading-tight mb-0.5">
                            Solenergi & Batterilagring
                        </h3>
                        <p class="text-[10px] text-slate-200 leading-snug">
                            Kompletta, säkra lösningar med upp till 50 % Grön Teknik-avdrag.
                        </p>
                    </div>
                </div>

                <!-- Tjänst 2: Laddboxar -->
                <div class="relative w-full aspect-square max-h-[65mm] rounded-xl overflow-hidden shadow-sm border border-slate-200">
                    <img 
                        src="https://images.unsplash.com/photo-1593941707882-a5bba14938c7?auto=format&fit=crop&q=80&w=800" 
                        alt="Laddboxar" 
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <!-- Mjuk botten-gradient endast bakom texten -->
                    <div class="absolute inset-x-0 bottom-0 h-[48%] bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent flex flex-col justify-end p-3">
                        <h3 class="font-bold text-[12px] text-white font-display leading-tight mb-0.5">
                            Laddboxar
                        </h3>
                        <p class="text-[10px] text-slate-200 leading-snug">
                            Säker elbilsladdning för hemmet med smart lastbalansering.
                        </p>
                    </div>
                </div>

                <!-- Tjänst 3: Elinstallation & Service -->
                <div class="relative w-full aspect-square max-h-[65mm] rounded-xl overflow-hidden shadow-sm border border-slate-200">
                    <img 
                        src="https://images.unsplash.com/photo-1720415353460-957325a7267d?auto=format&fit=crop&q=80&w=800" 
                        alt="Elinstallation & Service" 
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <!-- Mjuk botten-gradient endast bakom texten -->
                    <div class="absolute inset-x-0 bottom-0 h-[48%] bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent flex flex-col justify-end p-3">
                        <h3 class="font-bold text-[12px] text-white font-display leading-tight mb-0.5">
                            Elinstallation & Service
                        </h3>
                        <p class="text-[10px] text-slate-200 leading-snug">
                            Fackmannamässiga eldragningar, felsökning och service.
                        </p>
                    </div>
                </div>

                <!-- Tjänst 4: Renovering & Nybygge -->
                <div class="relative w-full aspect-square max-h-[65mm] rounded-xl overflow-hidden shadow-sm border border-slate-200">
                    <Image 
                        src={heroRightImg} 
                        alt="Renovering & Nybygge" 
                        class="absolute inset-0 w-full h-full object-cover object-center"
                        widths={[600, 800]}
                    />
                    <!-- Mjuk botten-gradient endast bakom texten -->
                    <div class="absolute inset-x-0 bottom-0 h-[48%] bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent flex flex-col justify-end p-3">
                        <h3 class="font-bold text-[12px] text-white font-display leading-tight mb-0.5">
                            Renovering & Nybygge
                        </h3>
                        <p class="text-[10px] text-slate-200 leading-snug">
                            Kompletta elarbeten för kök, badrum och nyproduktion.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. VARFÖR VÄLJA ELPROJEKT? (Bygg förtroende) -->
        <section class="bg-blue-50/70 border border-blue-200/80 rounded-xl p-3.5">
            <div class="flex items-center gap-1.5 mb-2">
                <CheckBadgeIcon className="w-4 h-4 text-elorange flex-shrink-0" />
                <h2 class="text-[12px] font-display font-extrabold text-elblue uppercase tracking-wider">
                    Varför välja ELPROJEKT?
                </h2>
            </div>
            
            <div class="grid grid-cols-3 gap-3">
                <!-- Punkt 1 -->
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-elorange flex-shrink-0"></span>
                        <h3 class="text-[11px] font-bold text-slate-900 font-display">Personlig kontakt</h3>
                    </div>
                    <p class="text-[10px] text-slate-600 leading-snug pl-2.5">
                        Inga mellanhänder. Du pratar och planerar direkt med elektrikern som utför jobbet.
                    </p>
                </div>

                <!-- Punkt 2 -->
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-elorange flex-shrink-0"></span>
                        <h3 class="text-[11px] font-bold text-slate-900 font-display">Helhetslösningar</h3>
                    </div>
                    <p class="text-[10px] text-slate-600 leading-snug pl-2.5">
                        Kräver projektet snickare eller takläggare? Vi sköter samordningen via vårt samarbete med Byggprojekt.
                    </p>
                </div>

                <!-- Punkt 3 -->
                <div class="space-y-0.5">
                    <div class="flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-elorange flex-shrink-0"></span>
                        <h3 class="text-[11px] font-bold text-slate-900 font-display">Din trygghet</h3>
                    </div>
                    <p class="text-[10px] text-slate-600 leading-snug pl-2.5">
                        Jag är auktoriserad elinstallatör med full ansvarsförsäkring och lämnar tydliga offerter med fasta priser.
                    </p>
                </div>
            </div>
        </section>

        <!-- 4. KONTAKT & NÄSTA STEG (Längst ner med större profilbild på Alexander & centrerad text) -->
        <footer class="bg-slate-900 text-white rounded-xl p-3 border-t-2 border-elorange shadow-md">
            <div class="flex items-center justify-between gap-3">
                
                <!-- Profilbild på Alexander (Perfekt inpassad utan inzoomning) -->
                <div class="flex-shrink-0 flex flex-col items-center pl-1">
                    <div class="w-[70px] h-[70px] rounded-full border-2 border-elorange overflow-hidden shadow-md bg-slate-100 flex items-center justify-center">
                        <Image 
                            src={alexImg} 
                            alt="Alexander - Elprojekt" 
                            class="w-full h-full object-contain object-bottom"
                            width={140}
                            height={140}
                        />
                    </div>
                    <span class="text-[8.5px] font-bold text-slate-300 font-display tracking-tight mt-1 text-center whitespace-nowrap">
                        Alexander
                    </span>
                </div>

                <!-- Mitten: Centrerad CTA & Kontaktuppgifter -->
                <div class="flex-1 flex flex-col items-center text-center space-y-1 px-1">
                    <div>
                        <span class="text-elorange font-display text-[9px] font-bold uppercase tracking-widest block">
                            Kostnadsfri Förfrågan & Offert
                        </span>
                        <h2 class="text-[14px] font-display font-extrabold text-white leading-tight">
                            Starta ditt nästa elprojekt nu!
                        </h2>
                        <p class="text-[10px] text-slate-300">
                            Vi sköter avdragen för <strong class="text-white">ROT</strong> och <strong class="text-white">Grön Teknik</strong> direkt på fakturan.
                        </p>
                    </div>

                    <!-- Kontaktuppgifter centrerade -->
                    <div class="flex flex-wrap items-center justify-center gap-1.5 pt-0.5">
                        <!-- Telefon -->
                        <a href="tel:0703325655" class="inline-flex items-center gap-1 bg-white/10 px-2 py-1 rounded-md text-white text-[10px] font-bold border border-white/15">
                            <PhoneIcon className="w-3 h-3 text-elorange flex-shrink-0" />
                            070-332 56 55
                        </a>

                        <!-- E-post -->
                        <a href="mailto:alex@elprojekt.nu" class="inline-flex items-center gap-1 bg-white/10 px-2 py-1 rounded-md text-white text-[10px] font-bold border border-white/15">
                            <EnvelopeIcon className="w-3 h-3 text-elorange flex-shrink-0" />
                            alex@elprojekt.nu
                        </a>

                        <!-- Webbadress -->
                        <a href="https://elprojekt.nu" class="inline-flex items-center gap-1 bg-elblue px-2.5 py-1 rounded-md text-white text-[10px] font-bold border border-blue-400/40">
                            <span class="w-1.5 h-1.5 rounded-full bg-elorange"></span>
                            elprojekt.nu
                        </a>
                    </div>
                </div>

                <!-- Höger sida: QR-kod Box -->
                <div class="flex-shrink-0 flex flex-col items-center bg-white p-2 rounded-lg border border-slate-300 text-slate-900 shadow-sm w-[98px]">
                    <img 
                        src={qrDataUrl} 
                        alt="QR-kod till elprojekt.nu" 
                        class="w-[68px] h-[68px] object-contain block rounded"
                    />
                    <span class="text-[7.5px] font-display font-extrabold text-elblue text-center mt-1 uppercase tracking-tight leading-tight">
                        Erbjudanden & Inspiration
                    </span>
                </div>

            </div>
        </footer>

    </div>
</body>
</html>
