---
import "../../styles/global.css";
---

<!doctype html>
<html lang="sv">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Samvolt – Skylt (60 × 40 cm) Framtidens Energilagring</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* Exact 600x400 mm (60x40 cm) Sign Print Configuration (3:2) */
        @page {
            size: 600mm 400mm;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #32544c;
            color: #ffffff;
            -webkit-font-smoothing: antialiased;
        }

        /* Screen Preview */
        @media screen {
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 24px 16px;
                background-color: #0d1715;
            }

            .sign-container {
                width: min(94vw, 1050px);
                aspect-ratio: 60 / 40;
                background-color: #32544c;
                border-radius: 12px;
                box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.1);
                position: relative;
                overflow: hidden;
                container-type: size;
            }
        }

        /* Print Execution (100% Identical Scale & Proportions) */
        @media print {
            html, body {
                width: 600mm !important;
                height: 400mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #32544c !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .sign-container {
                width: 600mm !important;
                height: 400mm !important;
                max-width: 600mm !important;
                max-height: 400mm !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                overflow: hidden !important;
                page-break-after: avoid !important;
                page-break-inside: avoid !important;
                container-type: size;
                background-color: #32544c !important;
            }
        }

        .font-heading {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        /* Jämn vertikal fördelning (cqw / cqh) */
        .sign-inner {
            padding: 4.8cqh 4.8cqw;
        }

        .samvolt-card {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1.5px solid rgba(255, 255, 255, 0.14);
            border-radius: 2cqw;
            padding: 2.8cqh 2.8cqw;
        }

        .samvolt-footer-card {
            background: linear-gradient(135deg, rgba(216, 255, 96, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%);
            border: 1.5px solid rgba(216, 255, 96, 0.4);
            border-radius: 1.8cqw;
            padding: 2cqh 2.8cqw;
        }
    </style>
</head>
<body>

    <!-- On-screen preview toolbar -->
    <div class="no-print mb-5 flex flex-wrap gap-4 items-center justify-between max-w-[1050px] w-full bg-slate-900 text-white px-5 py-3 rounded-xl shadow-xl border border-slate-700">
        <div>
            <h1 class="text-sm font-bold tracking-wide text-white flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#d8ff60]"></span>
                Samvolt – Skylt (60 × 40 cm)
            </h1>
            <p class="text-[11px] text-slate-300">Format: 60 × 40 cm (600 × 400 mm) • Stor läsbar typografi • Skala 100%</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="bg-[#d8ff60] hover:bg-[#cbf748] text-[#1c332e] font-extrabold px-4 py-2 rounded-lg text-xs transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4 text-[#1c332e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                Skriv ut / Spara PDF
            </button>
            <a href="/media" class="bg-slate-800 hover:bg-slate-700 text-slate-100 hover:text-white font-semibold px-4 py-2 rounded-lg text-xs transition-all border border-slate-600 flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 text-[#d8ff60]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Tillbaka till Mediebanken
            </a>
        </div>
    </div>

    <!-- 60x40 CM SIGN CONTAINER -->
    <div class="sign-container select-none">
        <div class="sign-inner w-full h-full flex flex-col justify-between items-stretch">
            
            <!-- 1. HEADER SEKTION (Större, renare & luftigare) -->
            <div class="w-full flex items-center justify-between border-b border-white/20 pb-[1.8cqh]">
                <!-- Vänster: Stor Logga -->
                <div class="flex items-center">
                    <img 
                        src="/images/samvolt-logo.png" 
                        alt="Samvolt Logotyp" 
                        class="h-[8.4cqh] w-auto object-contain"
                    />
                </div>

                <!-- Höger: Tydligt huvudbudskap -->
                <div class="text-right">
                    <h1 class="font-heading font-black text-white text-[2.8cqw] leading-[1.05] tracking-tight">
                        Framtidens Energilagring
                    </h1>
                    <p class="text-[#d8ff60] text-[1.7cqw] font-bold tracking-tight mt-[0.3cqh]">
                        Optimerad för nordiskt klimat
                    </p>
                </div>
            </div>

            <!-- 2. TVÅ SPALTER (Större rubriker och brödtext under) -->
            <div class="grid grid-cols-2 gap-[2.8cqw] flex-1 my-[2cqh]">
                
                <!-- VÄNSTER: Solinteg Hybridväxelriktare -->
                <div class="samvolt-card flex flex-col justify-between h-full">
                    <!-- Kolumnrubrik -->
                    <div class="border-b border-white/15 pb-[1.2cqh]">
                        <span class="text-[#d8ff60] text-[1.3cqw] font-bold uppercase tracking-wider block">
                            Hybridväxelriktare
                        </span>
                        <h2 class="font-heading font-black text-white text-[3cqw] tracking-tight leading-none mt-[0.2cqh]">
                            Solinteg
                        </h2>
                    </div>

                    <!-- USP-lista med 2 rader per punkt och större font -->
                    <ul class="flex flex-col justify-between flex-1 pt-[1.4cqh]">
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">98,2 % verkningsgrad</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Maximal effekt under alla förhållanden</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Shade Repair</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">+2–4 % mer elproduktion vid skuggning</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Fasbalansering</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Flyttar ledig kapacitet och kapar effekttoppar</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Sömlös ö-drift (10 ms)</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Blixtsnabb backup vid strömavbrott</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Stödtjänster & Nordpool</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Integrerad mot CheckWatt, Enequi & SG Ready</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- HÖGER: Sunwoda Batterisystem -->
                <div class="samvolt-card flex flex-col justify-between h-full">
                    <!-- Kolumnrubrik -->
                    <div class="border-b border-white/15 pb-[1.2cqh]">
                        <span class="text-[#d8ff60] text-[1.3cqw] font-bold uppercase tracking-wider block">
                            Batterisystem
                        </span>
                        <h2 class="font-heading font-black text-white text-[3cqw] tracking-tight leading-none mt-[0.2cqh]">
                            Sunwoda
                        </h2>
                    </div>

                    <!-- USP-lista med 2 rader per punkt och större font -->
                    <ul class="flex flex-col justify-between flex-1 pt-[1.4cqh]">
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Premium LFP Grade A+</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">6 000 cykler & garanterad lång livslängd</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Fullt modulärt</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Mixa nya och gamla moduler vid utbyggnad</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">DC-DC Optimering</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Maximerad säkerhet & noll brandrisk</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">Plug & Play Montering</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Låg vikt och smidig installation</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-[1.1cqw]">
                            <span class="w-[2.1cqw] h-[2.1cqw] rounded-full bg-[#d8ff60] text-[#1c332e] flex items-center justify-center flex-shrink-0 font-black text-[1.2cqw] mt-[0.1cqh]">✓</span>
                            <div>
                                <span class="text-white font-bold text-[1.65cqw] block leading-snug">IP65 & Inbyggd värme</span>
                                <span class="text-white/80 text-[1.4cqw] block leading-tight">Extremt tyst drift (29 dB) för nordisk vinter</span>
                            </div>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- 3. FOOTER / SAMVOLT INTELLIGENCE MED AI-IKON & OFFICIELL VEKTOR-LOGOTYP -->
            <div class="samvolt-footer-card flex items-center justify-between gap-[2.4cqw]">
                <!-- Vänster: AI Ikon + Officiell Vektor-Logotyp & Feature Text -->
                <div class="flex items-center gap-[1.8cqw] flex-1">
                    <!-- AI Ikon -->
                    <div class="w-[4.4cqw] h-[4.4cqw] rounded-xl bg-[#d8ff60] text-[#1c332e] flex items-center justify-center font-black text-[2.3cqw] shadow-md flex-shrink-0">
                        AI
                    </div>
                    
                    <div class="flex flex-col gap-[0.5cqh] flex-1">
                        <!-- Officiell Samvolt Intelligence SVG-vektor -->
                        <img 
                            src="/images/samvolt-intelligence.svg" 
                            alt="Samvolt Intelligence" 
                            class="h-[2.8cqh] w-auto max-w-[28cqw] object-contain object-left invert brightness-200"
                        />
                        
                        <p class="text-white/90 text-[1.35cqw] font-medium leading-[1.3] m-0">
                            Analyserar, förutser och optimerar energiflöden i realtid med AI – så att varje batteri, växelriktare och kilowattimme arbetar smartare, dygnet runt.
                        </p>
                    </div>
                </div>

                <!-- Höger: Webbadress -->
                <div class="text-right pl-[2.4cqw] border-l border-white/20 flex-shrink-0">
                    <span class="text-[#d8ff60] font-heading font-black text-[1.9cqw] tracking-tight block">
                        samvolt.com
                    </span>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
