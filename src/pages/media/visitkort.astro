---
import QRCode from "qrcode";
import LogoTitle from "../../components/icons/LogoTitle.astro";
import PhoneIcon from "../../components/icons/PhoneIcon.astro";
import EnvelopeIcon from "../../components/icons/EnvelopeIcon.astro";
import "../../styles/global.css";

// Generera högupplöst QR-kod med färg matchad mot texten (slate-900: #0f172a)
const qrUrl = "https://elprojekt.nu/qr?src=visitkort";
const qrDataUrl = await QRCode.toDataURL(qrUrl, {
    width: 400,
    margin: 0,
    color: {
        dark: "#0f172a",
        light: "#ffffff"
    }
});
---

<!doctype html>
<html lang="sv">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELPROJEKT – Visitkort</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Exact Business Card Print Configuration (89x59 mm with 2mm bleed) */
        @page {
            size: 89mm 59mm;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
            background: #ffffff;
        }

        /* Screen Preview Styling */
        @media screen {
            body {
                background-color: #1e293b;
                padding: 40px 16px 80px;
                display: flex;
                flex-direction: column;
                align-items: center;
                min-height: 100vh;
            }

            .card-wrapper {
                filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.4));
            }
        }

        /* Print Execution (100% Identical to Screen) */
        @media print {
            html, body {
                width: 89mm !important;
                height: 59mm !important;
                max-width: 89mm !important;
                max-height: 59mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .card-wrapper {
                margin: 0 !important;
                padding: 0 !important;
                width: 89mm !important;
                height: 59mm !important;
                filter: none !important;
            }

            .card-print-area {
                width: 89mm !important;
                height: 59mm !important;
                max-width: 89mm !important;
                max-height: 59mm !important;
                margin: 0 !important;
                padding: 6.5mm 7.5mm 6.2mm !important;
                box-shadow: none !important;
                border: none !important;
                box-sizing: border-box !important;
                page-break-inside: avoid !important;
                page-break-after: avoid !important;
                page-break-before: avoid !important;
            }
        }

        .font-display {
            font-family: 'Bank Gothic Light', 'Inter', sans-serif;
        }
    </style>
</head>
<body>

    <!-- On-screen preview toolbar (Samma stil som övriga media-produkter) -->
    <div class="no-print mb-6 flex flex-wrap gap-4 items-center justify-between max-w-xl w-full bg-slate-900 text-white px-5 py-3 rounded-xl shadow-xl border border-slate-700">
        <div>
            <h1 class="text-sm font-bold font-display tracking-wide text-white">ELPROJEKT – Tryckfärdigt Visitkort</h1>
            <p class="text-[11px] text-slate-300">Format: 89 × 59 mm (inkl. 2mm bleed) • Skala 100%</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="bg-elorange hover:bg-orange-600 text-white font-bold px-4 py-2 rounded-lg text-xs transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                Skriv ut / Spara PDF
            </button>
            <a href="/media" class="bg-slate-800 hover:bg-slate-700 text-slate-100 hover:text-white font-semibold px-4 py-2 rounded-lg text-xs transition-all border border-slate-600 flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 text-elorange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Tillbaka till Mediebanken
            </a>
        </div>
    </div>


    <!-- VISITKORT PRINT CONTAINER -->
    <main class="card-wrapper">
        <!-- 89mm x 59mm Artboard (2mm Bleed, rent utan synliga skärlinjer) -->
        <div class="card-print-area w-[89mm] h-[59mm] bg-white text-slate-900 flex flex-col justify-between" style="padding: 6.5mm 7.5mm 6.2mm; box-sizing: border-box;">
            
            <!-- 1. CENTRERAD STÖRRE LOGOTYP MED DIVIDER UNDER -->
            <div class="flex flex-col items-center">
                <div class="w-[64mm]">
                    <LogoTitle className="w-full h-auto text-elblue" />
                </div>
                <!-- Divider under loggan -->
                <div class="w-full h-[0.6px] bg-slate-200 mt-2.5 mb-1"></div>
            </div>

            <!-- 2 & 3. NEDRE SEKTION: VÄNSTER KONTAKT & HÖGER QR -->
            <div class="flex items-end justify-between pb-0.5">
                
                <!-- 2. VÄNSTER: PERSON & KONTAKTUPPGIFTER MED IKONER -->
                <div class="flex flex-col gap-1.5 text-left">
                    <div>
                        <h2 class="text-[13pt] font-extrabold font-display text-slate-900 leading-none tracking-tight">
                            Alexander Norbäck
                        </h2>
                        <p class="text-[8.5pt] font-semibold text-elorange font-display tracking-wide uppercase mt-0.5">
                            Elinstallatör
                        </p>
                    </div>

                    <div class="space-y-1.5 pt-0.5 text-[8.5pt] leading-tight">
                        <!-- Telefon -->
                        <div class="flex items-center gap-1.5">
                            <PhoneIcon className="w-4 h-4 text-elblue flex-shrink-0" />
                            <span class="font-semibold text-slate-900">070-332 56 55</span>
                        </div>

                        <!-- E-post -->
                        <div class="flex items-center gap-1.5">
                            <EnvelopeIcon className="w-4 h-4 text-elblue flex-shrink-0" />
                            <span class="font-semibold text-slate-900">alex@elprojekt.nu</span>
                        </div>

                        <!-- Webb -->
                        <div class="flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-elblue flex-shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                            </svg>
                            <span class="font-semibold text-slate-900">elprojekt.nu</span>
                        </div>
                    </div>
                </div>

                <!-- 3. HÖGER: QR-KOD (Färgmatchad slate-900) -->
                <div class="flex flex-col items-center justify-end pl-2">
                    <img 
                        src={qrDataUrl} 
                        alt="QR-kod till Elprojekt" 
                        class="w-[19mm] h-[19mm] block"
                    />
                </div>

            </div>

        </div>
    </main>

</body>
</html>
