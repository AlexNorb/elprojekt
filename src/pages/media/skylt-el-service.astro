---
import "../../styles/global.css";
---

<!doctype html>
<html lang="sv">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELPROJEKT – Skylt 2 (120 × 50 cm) Elinstallationer & Service</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* Exact 1200x500 mm (120x50 cm) Sign Print Configuration */
        @page {
            size: 1200mm 500mm;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, sans-serif;
            background-color: #ffffff;
            -webkit-font-smoothing: antialiased;
        }

        /* Screen Preview */
        @media screen {
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 24px 16px;
                background-color: #0f172a;
            }

            .sign-container {
                width: min(94vw, 1200px);
                aspect-ratio: 120 / 50;
                background-color: #ffffff;
                border-radius: 8px;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.1);
                position: relative;
                overflow: hidden;
                container-type: size;
            }
        }

        /* Print Execution (100% Identical Scale & Proportions) */
        @media print {
            html, body {
                width: 1200mm !important;
                height: 500mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .no-print {
                display: none !important;
            }

            .sign-container {
                width: 1200mm !important;
                height: 500mm !important;
                max-width: 1200mm !important;
                max-height: 500mm !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                overflow: hidden !important;
                page-break-after: avoid !important;
                page-break-inside: avoid !important;
                container-type: size;
            }
        }

        .font-display {
            font-family: 'Bank Gothic Light', 'Inter', sans-serif;
        }

        /* 100% Proportional Container Units (cqw / cqh) */
        .sign-inner {
            padding: 6cqh 6cqw;
            gap: 2.6cqh;
        }

        .sign-title {
            font-size: 4.9cqw;
            line-height: 1.15;
            letter-spacing: -0.01em;
            text-align: center;
        }

        .sign-body {
            font-size: 2.1cqw;
            line-height: 1.45;
            width: 100%;
            max-width: 100%;
            text-align: center;
            gap: 0.7cqh;
        }

        .sign-body-line {
            white-space: nowrap;
        }

        .sign-rot-notice {
            font-size: 2.05cqw;
            line-height: 1.3;
        }

        .sign-grid {
            column-gap: 5cqw;
            row-gap: 1.5cqh;
            width: fit-content;
            margin: 0 auto;
        }

        .sign-keyword-item {
            font-size: 2.05cqw;
            letter-spacing: 0.03em;
            white-space: nowrap;
        }

        .sign-dot {
            width: 1.15cqw;
            height: 1.15cqw;
            border-radius: 9999px;
            background-color: #003ca6;
            flex-shrink: 0;
        }
    </style>
</head>
<body>

    <!-- On-screen preview toolbar -->
    <div class="no-print mb-5 flex flex-wrap gap-4 items-center justify-between max-w-[1200px] w-full bg-slate-900 text-white px-5 py-3 rounded-xl shadow-xl border border-slate-700">
        <div>
            <h1 class="text-sm font-bold font-display tracking-wide text-white">ELPROJEKT – Skylt 2: Elinstallationer & Service</h1>
            <p class="text-[11px] text-slate-300">Format: 120 × 50 cm (1200 × 500 mm) • Vit bakgrund • Ren typografi • Skala 100%</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="bg-elorange hover:bg-orange-600 text-white font-bold px-4 py-2 rounded-lg text-xs transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                Skriv ut / Spara PDF
            </button>
            <a href="/media" class="bg-slate-800 hover:bg-slate-700 text-slate-100 hover:text-white font-semibold px-4 py-2 rounded-lg text-xs transition-all border border-slate-600 flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5 text-elorange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Tillbaka till Mediebanken
            </a>
        </div>
    </div>

    <!-- 120x50 CM SIGN CONTAINER -->
    <div class="sign-container select-none">
        <div class="sign-inner w-full h-full flex flex-col justify-between items-center bg-white">
            
            <!-- 1. HUVUDRUBRIK (Helblå rubrik i 2 rader) -->
            <div class="w-full flex justify-center">
                <h1 class="sign-title font-display font-black uppercase text-center text-elblue">
                    <span class="block">Allt inom el</span>
                    <span class="text-[0.78em] font-extrabold block">
                        Tryggt, modernt och personligt.
                    </span>
                </h1>
            </div>

            <!-- 2. BRÖDTEXT (Centrerade 2 rader med luftig marginal emellan) -->
            <div class="w-full flex justify-center">
                <div class="sign-body text-slate-900 font-sans font-medium flex flex-col items-center justify-center">
                    <span class="sign-body-line block">Din lokala elfirma från första idé till färdig installation.</span>
                    <span class="sign-body-line block">Vi hjälper dig med allt från felsökning och service till kompletta elarbeten.</span>
                </div>
            </div>

            <!-- 2.5. ROT-AVDRAG NOTIS (Centrerad) -->
            <div class="w-full flex justify-center">
                <p class="sign-rot-notice text-slate-800 font-sans font-medium text-center">
                    <strong class="text-elorange font-bold">30% ROT-avdrag</strong> direkt på fakturan för alla arbetskostnader.
                </p>
            </div>

            <!-- 3. NYCKELORD (3x2 Grid - Hela blocket centrerat, kolumnerna linjerar strikt vertikalt) -->
            <div class="w-full flex justify-center">
                <div class="sign-grid grid grid-cols-3 font-display font-bold text-slate-800 uppercase">
                    
                    <!-- Rad 1, Kolumn 1 -->
                    <div class="sign-keyword-item flex items-center gap-[0.8cqw] justify-start">
                        <span class="sign-dot"></span>
                        <span>Renovering</span>
                    </div>

                    <!-- Rad 1, Kolumn 2 -->
                    <div class="sign-keyword-item flex items-center gap-[0.8cqw] justify-start">
                        <span class="sign-dot"></span>
                        <span>Kök & Badrum</span>
                    </div>

                    <!-- Rad 1, Kolumn 3 -->
                    <div class="sign-keyword-item flex items-center gap-[0.8cqw] justify-start">
                        <span class="sign-dot"></span>
                        <span>Belysning</span>
                    </div>

                    <!-- Rad 2, Kolumn 1 -->
                    <div class="sign-keyword-item flex items-center gap-[0.8cqw] justify-start">
                        <span class="sign-dot"></span>
                        <span>Nybygge</span>
                    </div>

                    <!-- Rad 2, Kolumn 2 -->
                    <div class="sign-keyword-item flex items-center gap-[0.8cqw] justify-start">
                        <span class="sign-dot"></span>
                        <span>Centralbyte</span>
                    </div>

                    <!-- Rad 2, Kolumn 3 -->
                    <div class="sign-keyword-item flex items-center gap-[0.8cqw] justify-start">
                        <span class="sign-dot"></span>
                        <span>Felsökning</span>
                    </div>

                </div>
            </div>

        </div>
    </div>

</body>
</html>
