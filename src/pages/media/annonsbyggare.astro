            "top-right": { x: 78, y: 14 },
            "top-left": { x: 22, y: 14 },
            "bottom-right": { x: 78, y: 86 },
            "bottom-left": { x: 22, y: 86 },
        };

        function makeDraggable(targetEl, getPos, setPos) {
            let dragging = false;
            let startX = 0;
            let startY = 0;
            let origX = 0;
            let origY = 0;

            targetEl.addEventListener("pointerdown", (e) => {
                e.preventDefault();
                dragging = true;
                targetEl.setPointerCapture(e.pointerId);
                startX = e.clientX;
                startY = e.clientY;
                const pos = getPos();
                origX = pos.x;
                origY = pos.y;
            });

            targetEl.addEventListener("pointermove", (e) => {
                if (!dragging) return;
                const stageRect = el.previewStage.getBoundingClientRect();
                const dxPct = ((e.clientX - startX) / stageRect.width) * 100;
                const dyPct = ((e.clientY - startY) / stageRect.height) * 100;
                const nx = Math.max(4, Math.min(96, origX + dxPct));
                const ny = Math.max(4, Math.min(96, origY + dyPct));
                setPos(nx, ny);
            });

            const stop = (e) => {
                if (!dragging) return;
                dragging = false;
                if (targetEl.hasPointerCapture(e.pointerId)) {
                    targetEl.releasePointerCapture(e.pointerId);
                }
            };
            targetEl.addEventListener("pointerup", stop);
            targetEl.addEventListener("pointercancel", stop);
        }

        let nextOverlayId = 1;

        function parseInlineBold(text) {
            const spans = [];
            const parts = text.split(/(\*\*[^*]+\*\*)/g);
            for (const part of parts) {
                if (!part) continue;
                if (part.startsWith("**") && part.endsWith("**") && part.length > 4) {
                    spans.push({ text: part.slice(2, -2), bold: true });
                } else {
                    spans.push({ text: part, bold: false });
                }
            }
            return spans;
        }

        function parseMarkdownLines(md) {
            const lines = (md || "").split(/\r?\n/);
            return lines.map((raw) => {
                const trimmed = raw.trim();
                if (!trimmed) return { type: "spacer", spans: [] };
                if (trimmed.startsWith("### ")) return { type: "h3", spans: parseInlineBold(trimmed.slice(4)) };
                if (trimmed.startsWith("## ")) return { type: "h2", spans: parseInlineBold(trimmed.slice(3)) };
                if (trimmed.startsWith("# ")) return { type: "h1", spans: parseInlineBold(trimmed.slice(2)) };
                if (/^[-*•]\s+/.test(trimmed)) {
                    return { type: "bullet", spans: parseInlineBold(trimmed.replace(/^[-*•]\s+/, "")) };
                }
                return { type: "p", spans: parseInlineBold(raw) };
            });
        }

        function appendSpansToDom(parent, spans) {
            for (const sp of spans) {
                if (sp.bold) {
                    const strong = document.createElement("strong");
                    strong.style.fontWeight = "800";
                    strong.textContent = sp.text;
                    parent.appendChild(strong);
                } else {
                    parent.appendChild(document.createTextNode(sp.text));
                }
            }
        }

        function renderMarkdownToDom(container, md, scalePct) {
            container.innerHTML = "";
            const s = scalePct / 100;
            const parsed = parseMarkdownLines(md);
            for (const item of parsed) {
                if (item.type === "spacer") {
                    const div = document.createElement("div");
                    div.className = "ad-md-spacer";
                    container.appendChild(div);
                    continue;
                }
                const elLine = document.createElement("div");
                if (item.type === "h1") {
                    elLine.className = "ad-md-h1";
                    elLine.style.fontSize = `${3.9 * s}cqw`;
                    appendSpansToDom(elLine, item.spans);
                } else if (item.type === "h2") {
                    elLine.className = "ad-md-h2";
                    elLine.style.fontSize = `${3.1 * s}cqw`;
                    appendSpansToDom(elLine, item.spans);
                } else if (item.type === "h3") {
                    elLine.className = "ad-md-h3";
                    elLine.style.fontSize = `${2.6 * s}cqw`;
                    appendSpansToDom(elLine, item.spans);
                } else if (item.type === "bullet") {
                    elLine.className = "ad-md-bullet";
                    elLine.style.fontSize = `${2.45 * s}cqw`;
                    const dot = document.createElement("span");
                    dot.textContent = "•";
                    const content = document.createElement("span");
                    appendSpansToDom(content, item.spans);
                    elLine.appendChild(dot);
                    elLine.appendChild(content);
                } else {
                    elLine.className = "ad-md-p";
                    elLine.style.fontSize = `${2.45 * s}cqw`;
                    appendSpansToDom(elLine, item.spans);
                }
                container.appendChild(elLine);
            }
        }

