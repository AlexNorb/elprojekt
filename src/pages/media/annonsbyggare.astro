---
import QRCode from "qrcode";
import "../../styles/global.css";

const qrUrl = "https://elprojekt.nu/qr?src=annons";
const qrDataUrl = await QRCode.toDataURL(qrUrl, {
    width: 400,
    margin: 1,
    color: {
        dark: "#0f172a",
        light: "#ffffff",
    },
});
---

<!doctype html>
<html lang="sv">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELPROJEKT – Annonsbyggare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Oswald:wght@500;600;700&display=swap"
        rel="stylesheet"
    />
    <style is:global>
        @page {
            size: 216mm 384mm;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: "Inter", system-ui, sans-serif;
            background-color: #0b0f19;
            color: #f8fafc;
            -webkit-font-smoothing: antialiased;
        }

        .font-display {
            font-family: "Bank Gothic Light", "Inter", sans-serif;
        }

        .font-condensed {
            font-family: "Oswald", "Inter", sans-serif;
        }

        .hidden {
            display: none !important;
        }

        /* Screen layout: Editor sidebar + Live 9:16 preview */
        @media screen {
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }
            .poster-container {
                height: calc(100vh - 92px);
                max-height: 920px;
                aspect-ratio: 9 / 16;
                width: auto;
                max-width: 92vw;
                border-radius: 12px;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.12);
                position: relative;
                overflow: hidden;
                background-color: #ffffff;
                container-type: size;
                flex-shrink: 0;
            }
        }

        /* Exact 9:16 PDF Export & Print */
        @media print {
            html, body {
                width: 216mm !important;
                height: 384mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            .preview-stage {
                padding: 0 !important;
                margin: 0 !important;
                display: block !important;
                background: transparent !important;
            }
            .poster-container {
                width: 216mm !important;
                height: 384mm !important;
                max-width: 216mm !important;
                max-height: 384mm !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                overflow: hidden !important;
                page-break-after: avoid !important;
                page-break-inside: avoid !important;
                container-type: size;
            }
        }

        /* 100% Proportional Typography & Spacing via Container Units (cqw / cqh) */
        .ad-header {
            padding: 2.8cqh 6cqw 2.4cqh;
            text-align: center;
            position: relative;
            z-index: 20;
            flex-shrink: 0;
        }
        .ad-logo-wrap {
            width: 48cqw;
            margin: 0 auto 1.2cqh;
        }
        .ad-campaign-title {
            font-family: "Oswald", "Inter", sans-serif;
            font-size: 9.2cqw;
            line-height: 1;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .ad-campaign-sub {
            font-size: 2.35cqw;
            line-height: 1.3;
            font-weight: 500;
            margin-top: 0.8cqh;
            opacity: 0.92;
        }

        .ad-stage {
            position: relative;
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .ad-bg-studio-light {
            background: radial-gradient(circle at 50% 45%, #f1f5f9 0%, #dce2ea 55%, #cbd5e1 100%);
        }
        .ad-bg-pure-white {
            background: #ffffff;
        }
        .ad-bg-studio-dark {
            background: radial-gradient(circle at 50% 45%, #1e293b 0%, #0f172a 65%, #020617 100%);
        }

        .ad-product-img {
            position: relative;
            z-index: 10;
            pointer-events: none;
            user-select: none;
        }
        .ad-product-img.fit-contain {
            max-width: 82cqw;
            max-height: 82%;
            object-fit: contain;
        }
        .ad-product-img.fit-cover {
            width: 100%;
            height: 100%;
            max-width: none;
            max-height: none;
            object-fit: cover;
        }

        /* Draggable Overlays */
        .ad-draggable {
            position: absolute;
            z-index: 25;
            user-select: none;
            cursor: grab;
            touch-action: none;
        }
        .ad-draggable:active {
            cursor: grabbing;
        }
        @media screen {
            .ad-draggable:hover {
                outline: 2px dashed rgba(255, 116, 3, 0.8);
                outline-offset: 4px;
            }
        }

        /* Overlay Badges */
        .ad-badge {
            box-shadow: 0 1.4cqh 3cqw rgba(15, 23, 42, 0.28);
            text-align: center;
            --badge-rot: 0deg;
            transform: translate(-50%, -50%) rotate(var(--badge-rot));
        }

        .ad-badge-tilted-price {
            background: linear-gradient(135deg, #ff7403 0%, #e65c00 100%);
            color: #ffffff;
            padding: 1.8cqh 4.5cqw;
            border-radius: 2.2cqw;
            --badge-rot: 7deg;
            border: 0.35cqw solid rgba(255, 255, 255, 0.35);
        }
        .ad-badge-flat-price {
            background: linear-gradient(135deg, #ff7403 0%, #e65c00 100%);
            color: #ffffff;
            padding: 1.8cqh 4.5cqw;
            border-radius: 2cqw;
            --badge-rot: 0deg;
            border: 0.35cqw solid rgba(255, 255, 255, 0.35);
        }
        .ad-badge-pill-campaign {
            background: #0f172a;
            color: #ffffff;
            padding: 1.4cqh 4.5cqw;
            border-radius: 999px;
            --badge-rot: 0deg;
            border: 0.4cqw solid #ff7403;
        }
        .ad-badge-circle-burst {
            background: linear-gradient(135deg, #ff7403 0%, #dc2626 100%);
            color: #ffffff;
            width: 24cqw;
            height: 24cqw;
            border-radius: 999px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2cqw;
            --badge-rot: -6deg;
            border: 0.45cqw solid #ffffff;
        }

        /* Text Overlay Block */
        .ad-text-overlay {
            transform: translate(-50%, -50%);
            padding: 2cqh 3.8cqw;
            border-radius: 2cqw;
            z-index: 24;
        }
        .ad-text-overlay-dark-glass {
            background: rgba(15, 23, 42, 0.52);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            color: #ffffff;
            box-shadow: 0 1.4cqh 3.5cqw rgba(2, 6, 23, 0.35), inset 0 0.15cqh 0 rgba(255, 255, 255, 0.25);
            border: 0.28cqw solid rgba(255, 255, 255, 0.28);
        }
        .ad-text-overlay-light-glass {
            background: rgba(255, 255, 255, 0.58);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            color: #0f172a;
            box-shadow: 0 1.4cqh 3.5cqw rgba(15, 23, 42, 0.16), inset 0 0.15cqh 0 rgba(255, 255, 255, 0.8);
            border: 0.28cqw solid rgba(255, 255, 255, 0.65);
        }
        .ad-text-overlay-clean-white {
            background: transparent;
            color: #ffffff;
            text-shadow: 0 0.4cqh 1.4cqw rgba(0, 0, 0, 0.72);
            padding: 0.8cqh 1.5cqw;
        }
        .ad-text-overlay-clean-dark {
            background: transparent;
            color: #0f172a;
            padding: 0.8cqh 1.5cqw;
        }
        .ad-md-h1 {
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.015em;
            margin-bottom: 0.45cqh;
            white-space: pre-wrap;
        }
        .ad-md-h2 {
            font-weight: 700;
            line-height: 1.2;
            margin-top: 0.35cqh;
            margin-bottom: 0.35cqh;
            white-space: pre-wrap;
        }
        .ad-md-h3 {
            font-weight: 700;
            line-height: 1.25;
            margin-top: 0.25cqh;
            margin-bottom: 0.25cqh;
            white-space: pre-wrap;
        }
        .ad-md-p,
        .ad-md-bullet {
            font-weight: 500;
            line-height: 1.38;
            opacity: 0.95;
            white-space: pre-wrap;
        }
        .ad-md-bullet {
            display: flex;
            gap: 1.1cqw;
            align-items: flex-start;
        }
        .ad-md-spacer {
            height: 0.9cqh;
        }
        .ad-image-overlay {
            transform: translate(-50%, -50%);
            z-index: 24;
            border-radius: 2cqw;
        }
        .ad-image-overlay-transparent {
            background: transparent;
            padding: 0;
        }
        .ad-image-overlay-dark-glass {
            background: rgba(15, 23, 42, 0.52);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            padding: 1.6cqh 2.8cqw;
            box-shadow: 0 1.4cqh 3.5cqw rgba(2, 6, 23, 0.35), inset 0 0.15cqh 0 rgba(255, 255, 255, 0.25);
            border: 0.28cqw solid rgba(255, 255, 255, 0.28);
        }
        .ad-image-overlay-light-glass {
            background: rgba(255, 255, 255, 0.58);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            padding: 1.6cqh 2.8cqw;
            box-shadow: 0 1.4cqh 3.5cqw rgba(15, 23, 42, 0.16), inset 0 0.15cqh 0 rgba(255, 255, 255, 0.8);
            border: 0.28cqw solid rgba(255, 255, 255, 0.65);
        }
        .ad-image-overlay img {
            width: 100%;
            height: auto;
            display: block;
            pointer-events: none;
            user-select: none;
        }
        .ad-badge-main {
            font-family: "Oswald", "Inter", sans-serif;
            font-size: 6.2cqw;
            font-weight: 700;
            line-height: 1.05;
            white-space: nowrap;
        }
        .ad-badge-sub {
            font-size: 2.2cqw;
            font-weight: 600;
            line-height: 1.2;
            margin-top: 0.35cqh;
            opacity: 0.95;
            white-space: nowrap;
        }

        /* Footer */
        .ad-footer-wrap {
            position: relative;
            z-index: 20;
            flex-shrink: 0;
        }
        .ad-footer-info {
            background: #ffffff;
            padding: 2.4cqh 5.5cqw;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 3cqw;
            border-top: 0.25cqh solid rgba(15, 23, 42, 0.08);
        }
        .ad-footer-text-col {
            flex: 1 1 auto;
            text-align: center;
        }
        .ad-footer-text-col.with-qr {
            text-align: left;
        }
        .ad-footer-title {
            font-size: 4.3cqw;
            font-weight: 800;
            line-height: 1.18;
            color: #003ca6;
            letter-spacing: -0.015em;
        }
        .ad-footer-selling {
            font-size: 2.75cqw;
            font-weight: 600;
            line-height: 1.35;
            color: #1e293b;
            margin-top: 0.6cqh;
        }
        .ad-footer-local {
            font-size: 2.35cqw;
            font-weight: 500;
            line-height: 1.35;
            color: #475569;
            margin-top: 0.35cqh;
        }
        .ad-qr-card {
            width: 15cqw;
            flex-shrink: 0;
            background: #ffffff;
            border: 0.25cqw solid #e2e8f0;
            border-radius: 1.6cqw;
            padding: 1cqw;
            text-align: center;
            box-shadow: 0 0.5cqh 1.5cqw rgba(15, 23, 42, 0.08);
        }
        .ad-qr-card img {
            width: 100%;
            height: auto;
            display: block;
        }
        .ad-qr-card span {
            display: block;
            font-size: 1.45cqw;
            font-weight: 800;
            color: #0f172a;
            margin-top: 0.3cqh;
            text-transform: uppercase;
        }
        .ad-contact-bar {
            padding: 1.5cqh 4cqw;
            text-align: center;
            font-size: 2.35cqw;
            font-weight: 600;
            letter-spacing: 0.01em;
            color: #ffffff;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100">

    <!-- Top Toolbar -->
    <header class="no-print h-14 px-4 sm:px-6 bg-slate-900 border-b border-slate-800 flex items-center justify-between gap-4 shrink-0">
        <div class="flex items-center gap-3 min-w-0">
            <a href="/media" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg border border-slate-700 transition-colors shrink-0">
                <svg class="w-3.5 h-3.5 text-elorange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Mediebank
            </a>
            <div class="truncate">
                <span class="text-sm font-bold font-display tracking-wide text-white">ELPROJEKT Annonsbyggare</span>
                <span id="header-format-label" class="hidden md:inline-block ml-2 text-xs text-slate-400">• 9:16 Showroom & Digital Skylt</span>
            </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <button
                id="btn-export-jpg"
                type="button"
                class="bg-elorange hover:bg-orange-600 text-white font-bold px-3.5 py-2 rounded-lg text-xs transition-all shadow-md flex items-center gap-1.5 cursor-pointer"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Ladda ner JPG
            </button>
            <button
                id="btn-export-pdf"
                type="button"
                onclick="window.print()"
                class="bg-elblue hover:bg-blue-700 text-white font-bold px-3.5 py-2 rounded-lg text-xs transition-all shadow-md flex items-center gap-1.5 cursor-pointer"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Spara PDF / Skriv ut
            </button>
        </div>
    </header>

    <!-- Main Workspace -->
    <div class="flex-1 flex flex-col lg:flex-row min-h-0">

        <!-- Left Editor Sidebar -->
        <aside class="no-print w-full lg:w-[390px] xl:w-[420px] bg-slate-900 border-b lg:border-b-0 lg:border-r border-slate-800 overflow-y-auto p-4 sm:p-5 space-y-5 shrink-0 lg:h-[calc(100vh-56px)]">

            <!-- 1. Format & Snabbmall -->
            <section class="bg-slate-800/60 border border-slate-700/80 rounded-xl p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-elorange font-display">1. Format & Mall</h2>
                    <button id="btn-reset" type="button" class="text-[11px] text-slate-400 hover:text-white underline cursor-pointer">Återställ</button>
                </div>

                <div>
                    <label for="input-format" class="block text-xs font-medium text-slate-300 mb-1">Storleksformat</label>
                    <select id="input-format" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-elorange">
                        <option value="9:16" selected>9:16 – Showroom / Skylt (1080×1920)</option>
                        <option value="4:5">4:5 – Instagram / Facebook (1080×1350)</option>
                        <option value="1:1">1:1 – Kvadratisk / Sociala medier (1080×1080)</option>
                        <option value="a4">A4 – Flyer (210×297 mm)</option>
                    </select>
                </div>

                <div>
                    <span class="block text-xs font-medium text-slate-300 mb-2">Tema</span>
                    <div class="flex items-center gap-3">
                        <button
                            type="button"
                            data-theme="kampanj-blue"
                            title="Blå"
                            aria-label="Blå tema"
                            class="theme-btn w-9 h-9 rounded-full border-2 border-elorange ring-2 ring-elorange/40 cursor-pointer transition-all shadow-sm"
                            style="background: linear-gradient(180deg, #003ca6 0%, #002a75 100%);"
                        ></button>
                        <button
                            type="button"
                            data-theme="black-friday"
                            title="Mörk"
                            aria-label="Mörk tema"
                            class="theme-btn w-9 h-9 rounded-full border-2 border-slate-600 cursor-pointer transition-all shadow-sm"
                            style="background: linear-gradient(180deg, #0f172a 0%, #020617 100%);"
                        ></button>
                        <button
                            type="button"
                            data-theme="clean-white"
                            title="Vit"
                            aria-label="Vit tema"
                            class="theme-btn w-9 h-9 rounded-full border-2 border-slate-600 cursor-pointer transition-all shadow-sm"
                            style="background: #ffffff;"
                        ></button>
                    </div>
                </div>
            </section>

            <!-- 2. Header -->
            <section class="bg-slate-800/60 border border-slate-700/80 rounded-xl p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-elorange font-display">2. Header (Topp)</h2>
                    <label class="inline-flex items-center gap-1.5 text-[11px] text-slate-300 cursor-pointer">
                        <input id="input-show-logo" type="checkbox" checked class="rounded accent-elorange" />
                        Visa logotyp
                    </label>
                </div>

                <div>
                    <label for="input-campaign" class="block text-xs font-medium text-slate-300 mb-1">Kampanjrubrik</label>
                    <input id="input-campaign" type="text" value="BLACK FRIDAY" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-elorange" />
                </div>

                <div>
                    <label for="input-dates" class="block text-xs font-medium text-slate-300 mb-1">Underrubrik / Datum</label>
                    <input id="input-dates" type="text" value="Gäller 16 nov – 31 dec 2026" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-elorange" />
                </div>
            </section>

            <!-- 3. Produktbild (Drag & Drop) -->
            <section class="bg-slate-800/60 border border-slate-700/80 rounded-xl p-4 space-y-3">
                <h2 class="text-xs font-bold uppercase tracking-wider text-elorange font-display">3. Produktbild (Mitten)</h2>

                <div
                    id="sidebar-dropzone"
                    class="border-2 border-dashed border-slate-600 hover:border-elorange rounded-xl p-4 text-center cursor-pointer transition-colors bg-slate-950/60"
                >
                    <input id="input-image" type="file" accept="image/*" class="hidden" />
                    <svg class="w-7 h-7 mx-auto text-slate-400 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <p class="text-xs font-semibold text-white">Dra & släpp bild här eller klicka</p>
                    <p class="text-[11px] text-slate-400 mt-0.5">PNG med transparent bakgrund eller JPG (stöder även Ctrl+V)</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="input-fit" class="block text-[11px] text-slate-300 mb-1">Bildpassning</label>
                        <select id="input-fit" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white">
                            <option value="contain" selected>Anpassa (hela bilden)</option>
                            <option value="cover">Fyll ytan (Cover)</option>
                        </select>
                    </div>
                    <div>
                        <label for="input-bg" class="block text-[11px] text-slate-300 mb-1">Studiobakgrund</label>
                        <select id="input-bg" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white">
                            <option value="studio-light" selected>Ljus studio (som PDF)</option>
                            <option value="pure-white">Helvit</option>
                            <option value="studio-dark">Mörk studio</option>
                        </select>
                    </div>
                </div>

                <div>
                    <div class="flex justify-between text-[11px] text-slate-300 mb-1">
                        <span>Zoom / Storlek</span>
                        <span id="val-scale">100%</span>
                    </div>
                    <input id="input-scale" type="range" min="20" max="300" value="100" class="w-full accent-elorange cursor-pointer" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <div class="flex justify-between text-[11px] text-slate-300 mb-1">
                            <span>Flytta X</span>
                            <span id="val-pos-x">0%</span>
                        </div>
                        <input id="input-pos-x" type="range" min="-35" max="35" value="0" class="w-full accent-elorange cursor-pointer" />
                    </div>
                    <div>
                        <div class="flex justify-between text-[11px] text-slate-300 mb-1">
                            <span>Flytta Y</span>
                            <span id="val-pos-y">0%</span>
                        </div>
                        <input id="input-pos-y" type="range" min="-35" max="35" value="0" class="w-full accent-elorange cursor-pointer" />
                    </div>
