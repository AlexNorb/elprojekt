                headerSolidBottom: "#f8fafc",
                logoLight: false,
                contactBg: "#003ca6",
                contactColor: "#ffffff",
                titleColor: "#003ca6",
            },
        };

        const state = {
            format: "9:16",
            theme: "kampanj-blue",
            bg: "studio-light",
            fit: "contain",
            imageSrc: null,
            imageEl: null,
            scale: 100,
            posX: 0,
            posY: 0,
            showLogo: true,
            campaign: "BLACK FRIDAY",
            dates: "Gäller 16 nov – 31 dec 2026",
            badgeStyle: "tilted-price",
            badgeX: 78,
            badgeY: 14,
            priceMain: "5 900 kr",
            priceSub: "efter Grön Teknik",
            textOverlays: [],
            showSalesBox: true,
            title: "Laddbox Easee Charge – installerad",
            selling: "Ladda elbilen säkert och smart hemma",
            local: "Lokal elektriker i Uddevalla",
            showFooter: true,
            contact: "elprojekt.nu  ·  alex@elprojekt.nu  ·  070-332 56 55",
            showQr: false,
        };

        const printPageStyleEl = document.createElement("style");
        document.head.appendChild(printPageStyleEl);

        // DOM references
        const el = {
            posterContainer: document.getElementById("poster-container"),
            headerFormatLabel: document.getElementById("header-format-label"),
            printPageStyle: printPageStyleEl,
            previewHeader: document.getElementById("preview-header"),
            previewLogoWrap: document.getElementById("preview-logo-wrap"),
            logoLightHolder: document.getElementById("logo-light-holder"),
            logoDarkHolder: document.getElementById("logo-dark-holder"),
            previewCampaign: document.getElementById("preview-campaign"),
            previewDates: document.getElementById("preview-dates"),
            previewStage: document.getElementById("preview-stage"),
            previewImg: document.getElementById("preview-img"),
            previewBadge: document.getElementById("preview-badge"),
            previewBadgeMain: document.getElementById("preview-badge-main"),
            previewBadgeSub: document.getElementById("preview-badge-sub"),
            previewTextOverlaysLayer: document.getElementById("preview-text-overlays-layer"),
            previewFooterInfo: document.getElementById("preview-footer-info"),
            previewFooterTextCol: document.getElementById("preview-footer-text-col"),
            previewTitle: document.getElementById("preview-title"),
            previewSelling: document.getElementById("preview-selling"),
            previewLocal: document.getElementById("preview-local"),
            previewQrBox: document.getElementById("preview-qr-box"),
            previewQrImg: document.getElementById("preview-qr-img"),
            previewContactBar: document.getElementById("preview-contact-bar"),

            inputFormat: document.getElementById("input-format"),
            inputImage: document.getElementById("input-image"),
            sidebarDropzone: document.getElementById("sidebar-dropzone"),
            inputFit: document.getElementById("input-fit"),
            inputScale: document.getElementById("input-scale"),
            valScale: document.getElementById("val-scale"),
            inputPosX: document.getElementById("input-pos-x"),
            valPosX: document.getElementById("val-pos-x"),
            inputPosY: document.getElementById("input-pos-y"),
            valPosY: document.getElementById("val-pos-y"),
            inputBg: document.getElementById("input-bg"),
            inputShowLogo: document.getElementById("input-show-logo"),
            inputCampaign: document.getElementById("input-campaign"),
            inputDates: document.getElementById("input-dates"),
            inputBadgeStyle: document.getElementById("input-badge-style"),
            inputBadgePos: document.getElementById("input-badge-pos"),
            btnResetBadgePos: document.getElementById("btn-reset-badge-pos"),
            inputPriceMain: document.getElementById("input-price-main"),
            inputPriceSub: document.getElementById("input-price-sub"),
            btnAddTextOverlay: document.getElementById("btn-add-text-overlay"),
            btnAddImageOverlay: document.getElementById("btn-add-image-overlay"),
            textOverlaysList: document.getElementById("text-overlays-list"),
            textOverlaysEmpty: document.getElementById("text-overlays-empty"),
            inputShowSalesBox: document.getElementById("input-show-sales-box"),
            inputTitle: document.getElementById("input-title"),
            inputSelling: document.getElementById("input-selling"),
            inputLocal: document.getElementById("input-local"),
            inputShowFooter: document.getElementById("input-show-footer"),
            inputContact: document.getElementById("input-contact"),
            inputShowQr: document.getElementById("input-show-qr"),
            btnClearImage: document.getElementById("btn-clear-image"),
            btnReset: document.getElementById("btn-reset"),
            btnExportJpg: document.getElementById("btn-export-jpg"),
        };

        function render() {
            const fmt = FORMATS[state.format];
            const theme = THEMES[state.theme];

            // Format & Print @page sizing
            el.posterContainer.style.aspectRatio = fmt.aspect;
            el.posterContainer.dataset.format = fmt.id;
            if (el.headerFormatLabel) el.headerFormatLabel.textContent = fmt.label;
            el.printPageStyle.textContent = `
                @media print {
                    @page { size: ${fmt.printW} ${fmt.printH}; margin: 0; }
                    html, body { width: ${fmt.printW} !important; height: ${fmt.printH} !important; }
                    .poster-container {
                        width: ${fmt.printW} !important;
                        height: ${fmt.printH} !important;
                        max-width: ${fmt.printW} !important;
                        max-height: ${fmt.printH} !important;
                    }
                }
            `;

            // Header
            el.previewHeader.style.background = theme.headerBg;
            el.previewHeader.style.color = theme.headerColor;
            el.previewLogoWrap.classList.toggle("hidden", !state.showLogo);
            el.logoLightHolder.classList.toggle("hidden", !theme.logoLight);
            el.logoDarkHolder.classList.toggle("hidden", theme.logoLight);

            el.previewCampaign.textContent = state.campaign;
            el.previewCampaign.classList.toggle("hidden", !state.campaign.trim());
            el.previewDates.textContent = state.dates;
            el.previewDates.classList.toggle("hidden", !state.dates.trim());

            // Stage & Background
            el.previewStage.className = `ad-stage ad-bg-${state.bg}`;

            // Product Image
            if (state.imageSrc) {
                el.previewImg.src = state.imageSrc;
                el.previewImg.classList.remove("hidden", "fit-contain", "fit-cover");
                el.previewImg.classList.add(`fit-${state.fit}`);
                el.previewImg.style.transform = `translate(${state.posX}%, ${state.posY}%) scale(${state.scale / 100})`;
            } else {
                el.previewImg.classList.add("hidden");
            }

            // Badge
            if (state.badgeStyle === "none") {
                el.previewBadge.classList.add("hidden");
            } else {
                el.previewBadge.classList.remove("hidden");
                el.previewBadge.className = `ad-draggable ad-badge ad-badge-${state.badgeStyle}`;
                el.previewBadge.style.left = `${state.badgeX}%`;
                el.previewBadge.style.top = `${state.badgeY}%`;
                el.previewBadgeMain.textContent = state.priceMain;
                el.previewBadgeSub.textContent = state.priceSub;
                el.previewBadgeSub.classList.toggle("hidden", !state.priceSub.trim());
            }

            // Free-form Text Overlays
            syncPreviewTextOverlays();

            // Säljtext & Footer
            el.previewFooterInfo.classList.toggle("hidden", !state.showSalesBox);
            el.previewTitle.textContent = state.title;
            el.previewTitle.style.color = theme.titleColor;
            el.previewTitle.classList.toggle("hidden", !state.title.trim());

            el.previewSelling.textContent = state.selling;
            el.previewSelling.classList.toggle("hidden", !state.selling.trim());

            el.previewLocal.textContent = state.local;
            el.previewLocal.classList.toggle("hidden", !state.local.trim());

            el.previewQrBox.classList.toggle("hidden", !state.showQr);
            el.previewFooterTextCol.classList.toggle("with-qr", state.showQr);

            el.previewContactBar.classList.toggle("hidden", !state.showFooter);
            el.previewContactBar.textContent = state.contact;
            el.previewContactBar.style.background = theme.contactBg;
            el.previewContactBar.style.color = theme.contactColor;

            // Theme swatch buttons active state
            document.querySelectorAll(".theme-btn").forEach((btn) => {
                const isActive = btn.dataset.theme === state.theme;
                btn.classList.toggle("border-elorange", isActive);
                btn.classList.toggle("ring-2", isActive);
                btn.classList.toggle("ring-elorange/40", isActive);
                btn.classList.toggle("border-slate-600", !isActive);
            });
        }

        function loadImageFile(file) {
            if (!file || !file.type.startsWith("image/")) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                const dataUrl = e.target.result;
                const img = new Image();
                img.onload = () => {
                    state.imageSrc = dataUrl;
                    state.imageEl = img;
                    render();
                };
                img.src = dataUrl;
            };
            reader.readAsDataURL(file);
        }

        // Theme selection
        document.querySelectorAll(".theme-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                state.theme = btn.dataset.theme;
                render();
            });
        });

        // File upload & Drag/Drop (sidebar only)
        el.sidebarDropzone.addEventListener("click", () => el.inputImage.click());
        el.inputImage.addEventListener("change", (e) => {
            if (e.target.files?.[0]) loadImageFile(e.target.files[0]);
        });

        el.sidebarDropzone.addEventListener("dragover", (e) => {
            e.preventDefault();
            el.sidebarDropzone.classList.add("border-elorange");
        });
        el.sidebarDropzone.addEventListener("dragleave", () => {
            el.sidebarDropzone.classList.remove("border-elorange");
        });
        el.sidebarDropzone.addEventListener("drop", (e) => {
            e.preventDefault();
            el.sidebarDropzone.classList.remove("border-elorange");
            const file = e.dataTransfer?.files?.[0];
            if (file) loadImageFile(file);
        });

        // Paste image support (Ctrl+V)
        window.addEventListener("paste", (e) => {
            const items = e.clipboardData?.items;
            if (!items) return;
            for (const item of items) {
                if (item.type.startsWith("image/")) {
                    loadImageFile(item.getAsFile());
                    break;
                }
            }
        });

        // Bind inputs
        el.inputFormat.addEventListener("change", (e) => {
            state.format = e.target.value;
            render();
        });
        el.inputFit.addEventListener("change", (e) => {
            state.fit = e.target.value;
            render();
        });
        el.inputScale.addEventListener("input", (e) => {
            state.scale = Number(e.target.value);
            el.valScale.textContent = `${state.scale}%`;
            render();
        });
        el.inputPosX.addEventListener("input", (e) => {
            state.posX = Number(e.target.value);
            el.valPosX.textContent = `${state.posX}%`;
            render();
        });
        el.inputPosY.addEventListener("input", (e) => {
            state.posY = Number(e.target.value);
            el.valPosY.textContent = `${state.posY}%`;
            render();
        });
        el.inputBg.addEventListener("change", (e) => {
            state.bg = e.target.value;
            render();
        });
        el.inputShowLogo.addEventListener("change", (e) => {
            state.showLogo = e.target.checked;
            render();
        });
        el.inputCampaign.addEventListener("input", (e) => {
            state.campaign = e.target.value;
            render();
        });
        el.inputDates.addEventListener("input", (e) => {
            state.dates = e.target.value;
            render();
        });
