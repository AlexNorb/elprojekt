            "4:5": {
                id: "4:5",
                label: "• 4:5 Instagram / Facebook",
                aspect: "4 / 5",
                printW: "200mm",
                printH: "250mm",
                width: 1080,
                height: 1350,
                exportScale: 2, // 2160 x 2700
