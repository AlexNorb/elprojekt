        // High-Resolution JPG Export (Canvas 2D renderer at 2160 x 3840)
        function drawRoundedRect(ctx, x, y, w, h, r) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.lineTo(x + w - r, y);
            ctx.quadraticCurveTo(x + w, y, x + w, y + r);
            ctx.lineTo(x + w, y + h - r);
            ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
            ctx.lineTo(x + r, y + h);
            ctx.quadraticCurveTo(x, y + h, x, y + h - r);
            ctx.lineTo(x, y + r);
            ctx.quadraticCurveTo(x, y, x + r, y);
            ctx.closePath();
        }

        function loadLogoImage(src) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => resolve(img);
                img.onerror = (err) => reject(err);
                img.src = src;
            });
        }

        function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
            const words = text.split(" ");
            let line = "";
            let currentY = y;
            for (let n = 0; n < words.length; n++) {
                const testLine = line + words[n] + " ";
                if (ctx.measureText(testLine).width > maxWidth && n > 0) {
                    ctx.fillText(line.trim(), x, currentY);
                    line = words[n] + " ";
                    currentY += lineHeight;
                } else {
                    line = testLine;
                }
            }
            if (line.trim()) {
                ctx.fillText(line.trim(), x, currentY);
                currentY += lineHeight;
            }
            return currentY;
        }

        el.btnExportJpg.addEventListener("click", async () => {
            const btn = el.btnExportJpg;
            const origText = btn.innerHTML;
            btn.disabled = true;
            btn.textContent = "Skapar JPG...";

            try {
                await document.fonts.ready;

                const fmt = FORMATS[state.format];
                const theme = THEMES[state.theme];
                const W = fmt.width * fmt.exportScale;  // 2160
                const H = fmt.height * fmt.exportScale; // 3840

                const canvas = document.createElement("canvas");
                canvas.width = W;
                canvas.height = H;
                const ctx = canvas.getContext("2d");

                // 1. Measure layout proportions matching DOM
                const headerRect = el.previewHeader.getBoundingClientRect();
                const posterRect = document.getElementById("poster-container").getBoundingClientRect();
                const footerRect = document.querySelector(".ad-footer-wrap").getBoundingClientRect();
                const contactRect = el.previewContactBar.getBoundingClientRect();

                const headerH = Math.round((headerRect.height / posterRect.height) * H);
                const footerH = Math.round((footerRect.height / posterRect.height) * H);
                const contactH = Math.round((contactRect.height / posterRect.height) * H);
                const footerInfoH = footerH - contactH;
                const stageY = headerH;
                const stageH = H - headerH - footerH;

                // 2. Draw Studio Stage Background
                ctx.save();
                ctx.beginPath();
                ctx.rect(0, stageY, W, stageH);
                ctx.clip();

                if (state.bg === "pure-white") {
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(0, stageY, W, stageH);
                } else if (state.bg === "studio-dark") {
                    const grad = ctx.createRadialGradient(W * 0.5, stageY + stageH * 0.45, 0, W * 0.5, stageY + stageH * 0.45, W * 0.85);
                    grad.addColorStop(0, "#1e293b");
                    grad.addColorStop(0.65, "#0f172a");
                    grad.addColorStop(1, "#020617");
                    ctx.fillStyle = grad;
                    ctx.fillRect(0, stageY, W, stageH);
                } else {
                    const grad = ctx.createRadialGradient(W * 0.5, stageY + stageH * 0.45, 0, W * 0.5, stageY + stageH * 0.45, W * 0.85);
                    grad.addColorStop(0, "#f1f5f9");
                    grad.addColorStop(0.55, "#dce2ea");
                    grad.addColorStop(1, "#cbd5e1");
                    ctx.fillStyle = grad;
                    ctx.fillRect(0, stageY, W, stageH);
                }

                // 3. Draw Product Image
                if (state.imageEl) {
                    const natW = state.imageEl.naturalWidth;
                    const natH = state.imageEl.naturalHeight;
                    const baseRatio =
                        state.fit === "cover"
                            ? Math.max(W / natW, stageH / natH)
                            : Math.min((W * 0.82) / natW, (stageH * 0.82) / natH);
                    const baseW = natW * baseRatio;
                    const baseH = natH * baseRatio;
                    const boxW = state.fit === "cover" ? W : baseW;
                    const boxH = state.fit === "cover" ? stageH : baseH;
                    const s = state.scale / 100;
                    const drawW = baseW * s;
                    const drawH = baseH * s;
                    const centerX = W / 2 + (state.posX / 100) * boxW;
                    const centerY = stageY + stageH / 2 + (state.posY / 100) * boxH;
                    const drawX = centerX - drawW / 2;
                    const drawY = centerY - drawH / 2;
                    ctx.drawImage(state.imageEl, drawX, drawY, drawW, drawH);
                }

                // Snapshot stage for real frosted-glass blur if any glass text overlay is used
                let stageSnapshot = null;
                if (state.textOverlays.some((ov) => ov.style === "dark-glass" || ov.style === "light-glass")) {
                    stageSnapshot = document.createElement("canvas");
                    stageSnapshot.width = W;
                    stageSnapshot.height = H;
                    stageSnapshot.getContext("2d").drawImage(canvas, 0, 0);
                }

                const drawGlassCard = (bx, by, boxW, boxH, style) => {
                    ctx.save();
                    ctx.shadowColor = style === "dark-glass" ? "rgba(2, 6, 23, 0.35)" : "rgba(15, 23, 42, 0.16)";
                    ctx.shadowBlur = W * 0.035;
                    ctx.shadowOffsetY = H * 0.014;
                    ctx.fillStyle = style === "dark-glass" ? "rgba(15, 23, 42, 0.52)" : "rgba(255, 255, 255, 0.58)";
                    drawRoundedRect(ctx, bx, by, boxW, boxH, W * 0.02);
                    ctx.fill();
                    ctx.restore();

                    if (stageSnapshot) {
                        ctx.save();
                        drawRoundedRect(ctx, bx, by, boxW, boxH, W * 0.02);
                        ctx.clip();
                        ctx.filter = "blur(28px) saturate(1.5)";
                        ctx.drawImage(stageSnapshot, 0, 0);
                        ctx.filter = "none";
                        ctx.fillStyle = style === "dark-glass" ? "rgba(15, 23, 42, 0.52)" : "rgba(255, 255, 255, 0.58)";
                        ctx.fillRect(bx, by, boxW, boxH);
                        ctx.restore();
                    }

                    ctx.save();
                    drawRoundedRect(ctx, bx, by, boxW, boxH, W * 0.02);
                    ctx.lineWidth = W * 0.0028;
                    ctx.strokeStyle = style === "dark-glass" ? "rgba(255, 255, 255, 0.28)" : "rgba(255, 255, 255, 0.65)";
                    ctx.stroke();
                    ctx.restore();
                };

                // 4a. Draw Custom Overlays (Text Markdown & Image)
                for (const ov of state.textOverlays) {
                    if (ov.type === "image") {
                        if (!ov.imageEl) continue;
                        ctx.save();
                        const boxW = (ov.width / 100) * W;
                        const hasGlass = ov.style === "dark-glass" || ov.style === "light-glass";
                        const padX = hasGlass ? W * 0.028 : 0;
                        const padY = hasGlass ? H * 0.016 : 0;
                        const imgW = boxW - padX * 2;
                        const imgH = imgW * (ov.imageEl.naturalHeight / ov.imageEl.naturalWidth);
                        const boxH = imgH + padY * 2;
                        const cx = (ov.x / 100) * W;
                        const cy = stageY + (ov.y / 100) * stageH;
                        const bx = cx - boxW / 2;
                        const by = cy - boxH / 2;

                        if (hasGlass) drawGlassCard(bx, by, boxW, boxH, ov.style);
                        ctx.drawImage(ov.imageEl, bx + padX, by + padY, imgW, imgH);
                        ctx.restore();
                        continue;
                    }

                    if (!(ov.markdown || "").trim()) continue;
                    ctx.save();
                    const s = ov.scale / 100;
                    const boxW = (ov.width / 100) * W;
                    const isClean = ov.style.startsWith("clean-");
                    const padX = isClean ? W * 0.015 : W * 0.038;
                    const padY = isClean ? H * 0.008 : H * 0.02;
                    const innerW = boxW - padX * 2;

                    const wrapSpans = (spans, baseWeight, boldWeight, sizePx, maxW) => {
                        const tokens = [];
                        for (const sp of spans) {
                            const parts = sp.text.split(/(\s+)/);
                            for (const p of parts) {
                                if (p) tokens.push({ text: p, bold: sp.bold });
                            }
                        }
                        const lines = [];
                        let cur = [];
                        let curW = 0;
                        for (const tok of tokens) {
                            ctx.font = `${tok.bold ? boldWeight : baseWeight} ${sizePx}px "Inter", sans-serif`;
                            const tw = ctx.measureText(tok.text).width;
                            if (cur.length > 0 && curW + tw > maxW && tok.text.trim() !== "") {
                                lines.push(cur);
                                cur = tok.text.trim() === "" ? [] : [tok];
                                curW = tok.text.trim() === "" ? 0 : tw;
                            } else {
                                if (lines.length > 0 && cur.length === 0 && tok.text.trim() === "") continue;
                                cur.push(tok);
                                curW += tw;
                            }
                        }
                        if (cur.length > 0) lines.push(cur);
                        if (lines.length === 0) lines.push([]);
                        return lines;
                    };

                    const parsed = parseMarkdownLines(ov.markdown);
                    const blocks = [];
                    let totalH = 0;
                    for (const item of parsed) {
                        if (item.type === "spacer") {
                            const h = H * 0.009;
                            blocks.push({ type: "spacer", h });
                            totalH += h;
                            continue;
                        }
                        const cfg =
                            item.type === "h1"
                                ? { size: Math.round(W * 0.039 * s), lh: 1.15, w: 800, bw: 900, mt: 0, mb: H * 0.0045, bullet: false }
                                : item.type === "h2"
                                    ? { size: Math.round(W * 0.031 * s), lh: 1.2, w: 700, bw: 800, mt: H * 0.0035, mb: H * 0.0035, bullet: false }
                                    : item.type === "h3"
                                        ? { size: Math.round(W * 0.026 * s), lh: 1.25, w: 700, bw: 800, mt: H * 0.0025, mb: H * 0.0025, bullet: false }
                                        : { size: Math.round(W * 0.0245 * s), lh: 1.38, w: 500, bw: 800, mt: 0, mb: 0, bullet: item.type === "bullet" };

                        const bulletIndent = cfg.bullet ? W * 0.024 : 0;
                        const wrapped = wrapSpans(item.spans, cfg.w, cfg.bw, cfg.size, innerW - bulletIndent);
                        const lineH = cfg.size * cfg.lh;
                        const blockH = cfg.mt + wrapped.length * lineH + cfg.mb;
                        blocks.push({ ...cfg, wrapped, lineH, bulletIndent });
                        totalH += blockH;
                    }

                    const boxH = totalH + padY * 2;
                    const cx = (ov.x / 100) * W;
                    const cy = stageY + (ov.y / 100) * stageH;
                    const bx = cx - boxW / 2;
                    const by = cy - boxH / 2;

                    if (ov.style === "dark-glass" || ov.style === "light-glass") {
                        drawGlassCard(bx, by, boxW, boxH, ov.style);
                    }

                    const textColor =
                        ov.style === "dark-glass" || ov.style === "clean-white"
                            ? "#ffffff"
                            : "#0f172a";

                    if (ov.style === "clean-white") {
                        ctx.shadowColor = "rgba(0, 0, 0, 0.72)";
                        ctx.shadowBlur = W * 0.014;
                        ctx.shadowOffsetY = H * 0.004;
                    }

                    ctx.fillStyle = textColor;
                    ctx.textAlign = "left";
                    ctx.textBaseline = "top";
                    let ty = by + padY;

                    for (const blk of blocks) {
                        if (blk.type === "spacer") {
                            ty += blk.h;
                            continue;
                        }
                        ty += blk.mt;
                        for (let li = 0; li < blk.wrapped.length; li++) {
                            const lineTokens = blk.wrapped[li];
                            let lineW = 0;
                            for (const tok of lineTokens) {
                                ctx.font = `${tok.bold ? blk.bw : blk.w} ${blk.size}px "Inter", sans-serif`;
                                lineW += ctx.measureText(tok.text).width;
                            }
                            let lx =
                                ov.align === "center"
                                    ? cx - (lineW + blk.bulletIndent) / 2
                                    : bx + padX;

                            if (blk.bullet && li === 0) {
                                ctx.font = `${blk.w} ${blk.size}px "Inter", sans-serif`;
                                ctx.fillText("•", lx, ty);
                            }
                            lx += blk.bulletIndent;

                            for (const tok of lineTokens) {
                                ctx.font = `${tok.bold ? blk.bw : blk.w} ${blk.size}px "Inter", sans-serif`;
                                ctx.fillText(tok.text, lx, ty);
                                lx += ctx.measureText(tok.text).width;
                            }
                            ty += blk.lineH;
                        }
                        ty += blk.mb;
                    }
                    ctx.restore();
                }

                // 4b. Draw Overlay Badge
                if (state.badgeStyle !== "none") {
                    ctx.save();
                    const padX = W * 0.045;
                    const padY = H * 0.018;
                    ctx.font = `700 ${Math.round(W * 0.062)}px "Oswald", "Inter", sans-serif`;
                    const mainW = ctx.measureText(state.priceMain).width;
                    ctx.font = `600 ${Math.round(W * 0.022)}px "Inter", sans-serif`;
                    const subW = state.priceSub.trim() ? ctx.measureText(state.priceSub).width : 0;

                    let bW = Math.max(mainW, subW) + padX * 2;
                    let bH = W * 0.062 * 1.05 + (state.priceSub.trim() ? W * 0.022 * 1.6 : 0) + padY * 2;
                    if (state.badgeStyle === "circle-burst") {
                        bW = W * 0.24;
                        bH = W * 0.24;
                    }

                    const cx = (state.badgeX / 100) * W;
                    const cy = stageY + (state.badgeY / 100) * stageH;

                    ctx.translate(cx, cy);
                    if (state.badgeStyle === "tilted-price") ctx.rotate((7 * Math.PI) / 180);
                    if (state.badgeStyle === "circle-burst") ctx.rotate((-6 * Math.PI) / 180);

                    ctx.shadowColor = "rgba(15, 23, 42, 0.28)";
                    ctx.shadowBlur = W * 0.03;
                    ctx.shadowOffsetY = H * 0.012;

                    if (state.badgeStyle === "circle-burst") {
                        const bg = ctx.createLinearGradient(-bW / 2, -bH / 2, bW / 2, bH / 2);
                        bg.addColorStop(0, "#ff7403");
                        bg.addColorStop(1, "#dc2626");
                        ctx.fillStyle = bg;
                        ctx.beginPath();
                        ctx.arc(0, 0, bW / 2, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.shadowColor = "transparent";
                        ctx.lineWidth = W * 0.0045;
                        ctx.strokeStyle = "#ffffff";
                        ctx.stroke();
                    } else if (state.badgeStyle === "pill-campaign") {
                        ctx.fillStyle = "#0f172a";
                        drawRoundedRect(ctx, -bW / 2, -bH / 2, bW, bH, bH / 2);
                        ctx.fill();
                        ctx.shadowColor = "transparent";
                        ctx.lineWidth = W * 0.004;
                        ctx.strokeStyle = "#ff7403";
                        ctx.stroke();
                    } else {
                        const bg = ctx.createLinearGradient(-bW / 2, -bH / 2, bW / 2, bH / 2);
                        bg.addColorStop(0, "#ff7403");
                        bg.addColorStop(1, "#e65c00");
                        ctx.fillStyle = bg;
                        drawRoundedRect(ctx, -bW / 2, -bH / 2, bW, bH, W * 0.022);
                        ctx.fill();
                        ctx.shadowColor = "transparent";
                        ctx.lineWidth = W * 0.0035;
                        ctx.strokeStyle = "rgba(255, 255, 255, 0.35)";
                        ctx.stroke();
                    }

                    ctx.fillStyle = "#ffffff";
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    const hasSub = Boolean(state.priceSub.trim());
                    ctx.font = `700 ${Math.round(W * 0.062)}px "Oswald", "Inter", sans-serif`;
                    ctx.fillText(state.priceMain, 0, hasSub ? -W * 0.015 : 0);

                    if (hasSub) {
                        ctx.font = `600 ${Math.round(W * 0.022)}px "Inter", sans-serif`;
                        ctx.fillText(state.priceSub, 0, W * 0.032);
                    }
                    ctx.restore();
                }

                ctx.restore(); // end stage clip

                // 5. Draw Header
                const hGrad = ctx.createLinearGradient(0, 0, 0, headerH);
                hGrad.addColorStop(0, theme.headerSolidTop);
                hGrad.addColorStop(1, theme.headerSolidBottom);
                ctx.fillStyle = hGrad;
                ctx.fillRect(0, 0, W, headerH);

                let cursorY = H * 0.028;
                if (state.showLogo) {
                    const logoSrc = theme.logoLight
                        ? "/media/logos/elprojekt-logo-white.svg"
                        : "/media/logos/elprojekt-logo-primary.svg";
                    const logoImg = await loadLogoImage(logoSrc);
                    const logoW = W * 0.48;
                    const logoH = logoW * (logoImg.height / logoImg.width);
                    ctx.drawImage(logoImg, (W - logoW) / 2, cursorY, logoW, logoH);
                    cursorY += logoH + H * 0.012;
                }

                if (state.campaign.trim()) {
                    ctx.fillStyle = theme.headerColor;
                    ctx.textAlign = "center";
                    ctx.textBaseline = "top";
                    ctx.font = `700 ${Math.round(W * 0.092)}px "Oswald", "Inter", sans-serif`;
                    ctx.fillText(state.campaign.toUpperCase(), W / 2, cursorY);
                    cursorY += W * 0.092 * 1.02;
                }

                if (state.dates.trim()) {
                    ctx.fillStyle = theme.headerColor;
                    ctx.globalAlpha = 0.92;
                    ctx.textAlign = "center";
                    ctx.textBaseline = "top";
                    ctx.font = `500 ${Math.round(W * 0.0235)}px "Inter", sans-serif`;
                    ctx.fillText(state.dates, W / 2, cursorY + H * 0.006);
                    ctx.globalAlpha = 1;
                }

                // 6. Draw Säljtext & Footer
                const footerY = H - footerH;
                if (state.showSalesBox && footerInfoH > 0) {
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(0, footerY, W, footerInfoH);

                    ctx.fillStyle = "rgba(15, 23, 42, 0.08)";
                    ctx.fillRect(0, footerY, W, Math.max(2, H * 0.002));

                    const padFooterX = W * 0.055;
                    const qrSize = state.showQr ? W * 0.15 : 0;
                    const textMaxW = state.showQr ? W - padFooterX * 2 - qrSize - W * 0.03 : W - padFooterX * 2;
                    const textCenterX = state.showQr ? padFooterX : W / 2;

                    ctx.textAlign = state.showQr ? "left" : "center";
                    ctx.textBaseline = "top";
                    let fy = footerY + H * 0.024;

                    if (state.title.trim()) {
                        ctx.fillStyle = theme.titleColor;
                        ctx.font = `800 ${Math.round(W * 0.043)}px "Inter", sans-serif`;
                        fy = wrapText(ctx, state.title, textCenterX, fy, textMaxW, W * 0.043 * 1.18);
                    }
                    if (state.selling.trim()) {
                        fy += H * 0.005;
                        ctx.fillStyle = "#1e293b";
                        ctx.font = `600 ${Math.round(W * 0.0275)}px "Inter", sans-serif`;
                        fy = wrapText(ctx, state.selling, textCenterX, fy, textMaxW, W * 0.0275 * 1.35);
                    }
                    if (state.local.trim()) {
                        fy += H * 0.003;
                        ctx.fillStyle = "#475569";
                        ctx.font = `500 ${Math.round(W * 0.0235)}px "Inter", sans-serif`;
                        wrapText(ctx, state.local, textCenterX, fy, textMaxW, W * 0.0235 * 1.35);
                    }

                    if (state.showQr && el.previewQrImg.complete) {
                        const qx = W - padFooterX - qrSize;
                        const qy = footerY + (footerInfoH - qrSize) / 2;
                        ctx.fillStyle = "#ffffff";
                        drawRoundedRect(ctx, qx, qy, qrSize, qrSize, W * 0.016);
                        ctx.fill();
                        ctx.lineWidth = W * 0.0025;
                        ctx.strokeStyle = "#e2e8f0";
                        ctx.stroke();
                        const innerPad = W * 0.01;
                        ctx.drawImage(el.previewQrImg, qx + innerPad, qy + innerPad, qrSize - innerPad * 2, qrSize - innerPad * 2);
                    }
                }

                // Contact bar
                if (state.showFooter && contactH > 0) {
                    ctx.fillStyle = theme.contactBg;
                    ctx.fillRect(0, H - contactH, W, contactH);
                    ctx.fillStyle = theme.contactColor;
                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";
                    ctx.font = `600 ${Math.round(W * 0.0235)}px "Inter", sans-serif`;
                    ctx.fillText(state.contact, W / 2, H - contactH / 2);
                }

                // Trigger JPG download
                canvas.toBlob(
                    (blob) => {
                        if (!blob) return;
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement("a");
                        a.href = url;
                        a.download = fmt.filename;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        URL.revokeObjectURL(url);
                    },
                    "image/jpeg",
                    0.95
                );
            } catch (err) {
                console.error("JPG export failed:", err);
                alert("Kunde inte skapa JPG. Testa igen eller använd 'Spara PDF / Skriv ut'.");
            } finally {
                btn.disabled = false;
                btn.innerHTML = origText;
            }
        });

        // Initial render
        render();
    </script>
</body>
</html>
