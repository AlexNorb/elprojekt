{/* DYNAMISK PARAMETERHANTERING (UTM / Query params) & PAKETKNAPPAR */}
<script>
    document.addEventListener("astro:page-load", () => {
        const params = new URLSearchParams(window.location.search);
        
        // Hämta parametrar (stöd för både UTM och enkla namn)
        const source = params.get("utm_source") || params.get("src") || params.get("kalla");
        const campaign = params.get("utm_campaign") || params.get("kampanj") || params.get("tjanst");
        const area = params.get("omrade") || params.get("stad");

        const badgeEl = document.getElementById("qr-badge");
        const headingEl = document.getElementById("qr-heading");
        const subheadingEl = document.getElementById("qr-subheading");
        const serviceSelect = document.getElementById("serviceType") as HTMLSelectElement;
        const messageInput = document.getElementById("message") as HTMLTextAreaElement;
        const vcardBtn = document.getElementById("qr-vcard-btn");

        // Koppla paket-knapparna till formuläret
        const selectButtons = document.querySelectorAll(".select-package-btn");
        selectButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const pkgName = btn.getAttribute("data-package") || "";
                if (serviceSelect) {
                    if (pkgName.toLowerCase().includes("laddbox") || pkgName.toLowerCase().includes("zaptec")) {
                        serviceSelect.value = "Laddbox";
                    } else if (pkgName.toLowerCase().includes("sol") || pkgName.toLowerCase().includes("batteri")) {
                        serviceSelect.value = "Solceller";
                    }
                }
                if (messageInput && !messageInput.value) {
                    messageInput.value = `Hej Alexander! Jag är intresserad av kampanjerbjudandet gällande ${pkgName}. Kontakta mig gärna för mer information eller offert.`;
                }
                
                // Scrolla mjukt till kontaktformuläret
                const contactEl = document.getElementById("contact-form");
                if (contactEl) {
                    contactEl.scrollIntoView({ behavior: "smooth", block: "start" });
                    // Fokusera på namn-fältet efter skroll
                    setTimeout(() => {
                        const nameField = document.getElementById("name");
                        if (nameField) nameField.focus();
                    }, 600);
                }
            });
        });

        // 1. Anpassa badge efter källa (source)
        if (source) {
            const s = source.toLowerCase();
            if (s.includes("bil")) {
                if (badgeEl) badgeEl.innerText = "Scannad från servicebilen";
            } else if (s.includes("kort") || s.includes("visitkort")) {
                if (badgeEl) badgeEl.innerText = "Trevligt att råkas!";
                if (headingEl) headingEl.innerHTML = "Alexander Norbäck <br/><span class='text-elorange'>Din personliga elektriker.</span>";
                if (subheadingEl) subheadingEl.innerText = "Här når du mig direkt för rådgivning, snabba frågor eller kostnadsfri offert. Spara mina kontaktuppgifter direkt i mobilen nedan!";
                if (vcardBtn) vcardBtn.classList.remove("hidden");
            } else if (s.includes("flyer") || s.includes("utskick")) {
                if (badgeEl) badgeEl.innerText = "Exklusivt erbjudande via flyer";
            } else if (s.includes("skylt") || s.includes("bygge")) {
                if (badgeEl) badgeEl.innerText = "Pågående projekt i närområdet";
            } else if (s.includes("showroom")) {
                if (badgeEl) badgeEl.innerText = "Välkommen till vårt Showroom";
            }
        }

        // 2. Anpassa efter kampanj/tjänst
        if (campaign) {
            const c = campaign.toLowerCase();

            if (c.includes("laddbox") || c.includes("ladd") || c.includes("zaptec")) {
                if (headingEl) headingEl.innerHTML = "Laddbox med <br/><span class='text-elorange'>50% Grön Teknik.</span>";
                if (subheadingEl) subheadingEl.innerText = "Ladda elbilen säkert och snabbt hemma. Fast pris från 8 000 kr inklusive Zaptec laddbox, dynamisk lastbalansering och installation.";
                if (serviceSelect) serviceSelect.value = "Laddbox";
                highlightCard("card-laddbox");
            } else if (c.includes("batteri") || c.includes("lagring") || c.includes("ec")) {
                if (headingEl) headingEl.innerHTML = "Sigenergy EC <br/><span class='text-elorange'>15 kWh Batterilager.</span>";
                if (subheadingEl) subheadingEl.innerText = "Kapa effekttoppar och optimera elförbrukningen mot dyra elpristoppar. Från 65 000 kr inklusive 50% Grön Teknik och installation.";
                if (serviceSelect) serviceSelect.value = "Solceller";
                highlightCard("card-batteri");
            } else if (c.includes("sol") || c.includes("solceller")) {
                if (headingEl) headingEl.innerHTML = "Solceller & <br/><span class='text-elorange'>Sigenergy batterilager.</span>";
                if (subheadingEl) subheadingEl.innerText = "Sänk dina elkostnader och maximera din självständighet med 16 paneler och 15 kWh intelligent energilagring. Grön Teknik-avdrag direkt på fakturan.";
                if (serviceSelect) serviceSelect.value = "Solceller";
                highlightCard("card-sol-batteri");
            } else if (c.includes("service") || c.includes("central") || c.includes("propp")) {
                if (headingEl) headingEl.innerHTML = "Elservice & <br/><span class='text-elorange'>Centralbyte.</span>";
                if (subheadingEl) subheadingEl.innerText = "Snabb och trygg hjälp med statuskontroll, felsökning, byte till automatsäkringar och reparationer.";
                if (serviceSelect) serviceSelect.value = "Service & Felsökning";
            } else if (c.includes("plejd") || c.includes("smart")) {
                if (headingEl) headingEl.innerHTML = "Smarta hem & <br/><span class='text-elorange'>Plejd-styrning.</span>";
                if (subheadingEl) subheadingEl.innerText = "Styr belysningen med mobilen och astro-ur. Trådlöst, svenskt och användarvänligt.";
                if (serviceSelect) serviceSelect.value = "Offertförfrågan";
            }
        }

        // 3. Områdestext
        if (area && subheadingEl) {
            const areaFormatted = area.charAt(0).toUpperCase() + area.slice(1).toLowerCase();
            const note = document.createElement("span");
            note.className = "block mt-2 font-semibold text-white";
            note.innerText = `Din lokala elektriker på ${areaFormatted} och omnejd.`;
            subheadingEl.appendChild(note);
        }

        // Hjälpfunktion för att markera fokus-kort
        function highlightCard(cardId: string) {
            const card = document.getElementById(cardId);
            if (card) {
                card.classList.add("ring-4", "ring-elorange", "shadow-2xl");
            }
        }

        // 4. Umami Analytics Tracking för QR-scan
        if (typeof (window as any).umami !== "undefined") {
            (window as any).umami.track("QR Code Scan", {
                source: source || "showroom",
                campaign: campaign || "general",
                area: area || "all",
                referrer: document.referrer || "direct",
            });
        }
    });
</script>
