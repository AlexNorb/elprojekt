---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import MobileActionBar from "../components/MobileActionBar.astro";
import ContactForm from "../components/ContactForm.astro";
import BoltIcon from "../components/icons/BoltIcon.astro";
import BatteryIcon from "../components/icons/BatteryIcon.astro";
import CpuChipIcon from "../components/icons/CpuChipIcon.astro";
import CheckBadgeIcon from "../components/icons/CheckBadgeIcon.astro";
import PhoneIcon from "../components/icons/PhoneIcon.astro";
import EnvelopeIcon from "../components/icons/EnvelopeIcon.astro";
import ChevronDownIcon from "../components/icons/ChevronDownIcon.astro";
import { pb } from "../utils";
---

<MainLayout
    title="Aktuell Kampanj & Showroom | Elprojekt"
    description="Aktuella kampanjpaket på laddboxar (Zaptec Go), solceller och intelligenta Sigenergy batterilager. Trygg installation av behörig elektriker."
>
    <Navbar />

    <main id="main-content" class="min-h-screen bg-slate-50 pt-20">
        {/* HERO SECTION */}
        <section class="relative bg-slate-900 text-white py-14 lg:py-20 overflow-hidden">
            {/* Background Glow */}
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-elblue rounded-full mix-blend-screen filter blur-[140px] opacity-25 pointer-events-none"
            ></div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="max-w-3xl">
                    {/* Dynamic Source Badge */}
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-elorange text-xs sm:text-sm font-bold font-display uppercase tracking-wider mb-6 backdrop-blur-sm" id="qr-badge-container">
                        <span class="w-2 h-2 rounded-full bg-elorange animate-pulse"></span>
                        <span id="qr-badge">Aktuell Kampanj • Showroom</span>
                    </div>

                    <h1
                        id="qr-heading"
                        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white leading-tight mb-6"
                    >
                        Smarta energisystem & <br />
                        <span class="text-elorange">framtidens elbilsladdning.</span>
                    </h1>

                    <p
                        id="qr-subheading"
                        class="text-base sm:text-lg lg:text-xl text-slate-300 leading-relaxed font-sans mb-8 border-l-4 border-elorange pl-4 sm:pl-6"
                    >
                        Välkommen! Just nu kör vi kampanj på kompletta energipaket – från marknadsledande Zaptec-laddboxar till solceller och intelligenta Sigenergy batterilager. Alltid installerat med 50% Grön Teknik-avdrag och personlig service av auktoriserad elektriker.
                    </p>

                    <div class="flex flex-wrap gap-4 items-center">
                        <a
                            id="qr-vcard-btn"
                            href="/alexander-norback.vcf"
                            download="alexander-norback.vcf"
                            data-umami-event="Save Contact vCard Click"
                            class="hidden inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-white transition-all duration-200 bg-elorange font-display rounded-md hover:bg-orange-600 shadow-[0_4px_14px_0_rgba(255,116,3,0.39)] hover:-translate-y-0.5"
                        >
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Spara kontakt i mobilen
                        </a>
                        <a
                            href="#kampanj-paket"
                            class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-white transition-all duration-200 bg-elorange font-display rounded-md hover:bg-orange-600 shadow-[0_4px_14px_0_rgba(255,116,3,0.39)] hover:-translate-y-0.5"
                        >
                            Se Kampanjpaketen
                            <div class="ml-2 w-4 h-4 inline-block">
                                <ChevronDownIcon />
                            </div>
                        </a>
                        <a
                            href="#contact-form"
                            data-umami-event="QR Hero CTA Click"
                            class="inline-flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 text-base font-bold text-slate-200 transition-all duration-200 bg-white/10 border border-white/20 font-display rounded-md hover:bg-white/20 hover:text-white"
                        >
                            Prata med Alexander
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {/* KAMPANJSEKTION: SOLCELLER, BATTERI & LADDBOX */}
        <section id="kampanj-paket" class="py-16 sm:py-20 bg-slate-100/70 border-b border-slate-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-14">
                    <span class="inline-block px-3 py-1 rounded-full bg-orange-100 text-elorange font-bold tracking-wide uppercase text-xs sm:text-sm font-display mb-3">
                        Aktuella Erbjudanden
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-display tracking-tight">
                        Smarta Paket med Grön Teknik
                    </h2>
                    <p class="mt-3 text-slate-600 text-base sm:text-lg">
                        Färdiga helhetslösningar inklusive auktoriserad installation, driftsättning och skatteavdrag direkt på fakturan.
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
                    {/* KORT 1: LADDBOX (ZAPTEC GO & GO 2) */}
                    <div
                        id="card-laddbox"
                        class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between group"
                    >
                        <div>
                            {/* Bild & Badge */}
                            <div class="relative bg-slate-900 aspect-[4/3] overflow-hidden">
                                <img
                                    src="/images/campaign/zaptec-laddsystem.jpg"
                                    alt="Komplett laddsystem Zaptec Go laddbox med lastbalansering och kabel"
                                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                                <div class="absolute top-4 left-4">
                                    <span class="px-3 py-1.5 rounded-md bg-elblue text-white text-xs font-bold font-display uppercase tracking-wider shadow">
                                        50% Grön Teknik
                                    </span>
                                </div>
                                <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
                                    <div>
                                        <p class="text-xs uppercase font-bold text-slate-300 font-display tracking-wider">Laddsystem Paket</p>
                                        <h3 class="text-xl font-bold text-white font-display">Zaptec Go & Go 2</h3>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-xs text-slate-300 block">Paketpris från</span>
                                        <span class="text-2xl sm:text-3xl font-extrabold text-elorange font-display">8 000:-</span>
                                    </div>
                                </div>
                            </div>

                            {/* Innehåll & Sammanfattning */}
                            <div class="p-6 space-y-5">
                                {/* Standardpaket */}
                                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
                                    <div class="flex items-center justify-between mb-2">
                                        <h4 class="text-base font-bold text-slate-900 font-display flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-elblue"></span>
                                            Zaptec Go Standard
                                        </h4>
                                        <span class="font-bold text-slate-900 font-display text-sm">8 000 kr</span>
                                    </div>
                                    <ul class="text-xs text-slate-700 space-y-1.5">
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Zaptec Go laddbox</strong> (upp till 22 kW)</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Dynamisk lastbalansering</strong> (Sense)</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>7m laddkabel</strong> Typ 2 + kabelhållare</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Standardinstallation:</strong> Upp till 10m kabel, håltagning & driftsättning</span>
                                        </li>
                                    </ul>
                                </div>

                                {/* Uppgradering Zaptec Go 2 */}
                                <div class="p-4 rounded-xl bg-gradient-to-br from-orange-50/70 to-amber-50/70 border border-orange-200">
                                    <div class="flex items-center justify-between mb-2">
                                        <h4 class="text-sm font-bold text-slate-900 font-display flex items-center gap-1">
                                            <span>🚀</span> Zaptec Go 2 Uppgradering
                                        </h4>
                                        <span class="text-[11px] font-bold bg-elorange text-white px-2 py-0.5 rounded uppercase font-display">
                                            +1 500 kr (9 500 kr)
                                        </span>
                                    </div>
                                    <ul class="text-[11px] text-slate-700 space-y-1.5">
                                        <li class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-elorange"></span>
                                            <span><strong>V2G Ready:</strong> Förberedd för dubbelriktad laddning</span>
                                        </li>
                                        <li class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-elorange"></span>
                                            <span><strong>Inbyggd Display:</strong> Direkt koll på laddstatus & effekt</span>
                                        </li>
                                        <li class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-elorange"></span>
                                            <span><strong>MID-godkänd:</strong> Exakt debiteringsmätning för tjänstebil</span>
                                        </li>
                                        <li class="flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-elorange"></span>
                                            <span><strong>Premium finish:</strong> Extra robust nordisk konstruktion</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        {/* Kort CTA */}
                        <div class="p-6 pt-0">
                            <button
                                type="button"
                                data-package="Zaptec Go Laddsystem"
                                class="select-package-btn w-full flex items-center justify-center py-3.5 px-4 rounded-xl font-bold font-display text-white bg-elorange hover:bg-orange-600 shadow-md hover:shadow-lg transition-all duration-200 uppercase tracking-wider group-hover:-translate-y-0.5 cursor-pointer text-sm"
                            >
                                Välj Zaptec Paket →
                            </button>
                        </div>
                    </div>

                    {/* KORT 2: KOMPLETT SOL + BATTERIPAKET */}
                    <div
                        id="card-sol-batteri"
                        class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between group"
                    >
                        <div>
                            {/* Bild & Badge */}
                            <div class="relative bg-slate-900 aspect-[4/3] overflow-hidden">
                                <img
                                    src="/images/campaign/sigenergy-energilosning.jpg"
                                    alt="Sigenergy komplett energilösning med solpaneler och batterilager"
                                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                                <div class="absolute top-4 left-4">
                                    <span class="px-3 py-1.5 rounded-md bg-emerald-600 text-white text-xs font-bold font-display uppercase tracking-wider shadow">
                                        Totalentreprenad
                                    </span>
                                </div>
                                <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
                                    <div>
                                        <p class="text-xs uppercase font-bold text-slate-300 font-display tracking-wider">Sol + Lagring</p>
                                        <h3 class="text-xl font-bold text-white font-display">Solceller & Batteri</h3>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-xs text-slate-300 block">Paketpris från</span>
                                        <span class="text-2xl sm:text-3xl font-extrabold text-elorange font-display">130 000:-</span>
                                    </div>
                                </div>
                            </div>

                            {/* Innehåll & Sammanfattning */}
                            <div class="p-6 space-y-5">
                                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
                                    <div class="flex items-center justify-between mb-2">
                                        <h4 class="text-base font-bold text-slate-900 font-display flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                                            Komplett Sol- & Batteripaket
                                        </h4>
                                        <span class="font-bold text-slate-900 font-display text-sm">Från 130 000 kr</span>
                                    </div>
                                    <p class="text-xs text-slate-600 mb-3">
                                        Den kompletta lösningen för maximal självförsörjning och lägsta elkostnad.
                                    </p>
                                    <ul class="text-xs text-slate-700 space-y-2">
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>16 högeffektiva paneler</strong> (~7,5 kWp optimerad toppeffekt)</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>15 kWh Sigenergy batterilager</strong> (intelligent & stapelbart)</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Standardmontage & elinstallation</strong> av behörig elektriker</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Inkl. Grön Teknik:</strong> Avdrag direkt på fakturan</span>
                                        </li>
                                    </ul>
                                </div>

                                <div class="p-3.5 rounded-xl bg-emerald-50/70 border border-emerald-200/80 text-xs text-emerald-950 space-y-1">
                                    <p class="font-bold font-display">☀️ Maximal energifrihet</p>
                                    <p class="text-slate-600 text-[11px] leading-relaxed">
                                        Producera på dagen, lagra till kvällen och kapa dina elkostnader året runt.
                                    </p>
                                </div>
                            </div>
                        </div>

                        {/* Kort CTA */}
                        <div class="p-6 pt-0">
                            <button
                                type="button"
                                data-package="Komplett Sol- och Batteripaket"
                                class="select-package-btn w-full flex items-center justify-center py-3.5 px-4 rounded-xl font-bold font-display text-white bg-emerald-700 hover:bg-emerald-800 shadow-md hover:shadow-lg transition-all duration-200 uppercase tracking-wider group-hover:-translate-y-0.5 cursor-pointer text-sm"
                            >
                                Välj Sol + Batteri →
                            </button>
                        </div>
                    </div>

                    {/* KORT 3: ENDAST BATTERILAGER (SIGENERGY EC) */}
                    <div
                        id="card-batteri"
                        class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between group"
                    >
                        <div>
                            {/* Bild & Badge */}
                            <div class="relative bg-slate-900 aspect-[4/3] overflow-hidden">
                                <img
                                    src="/images/campaign/sigenergy-batterilager.jpg"
                                    alt="Sigenergy EC batterilager 15kWh för spotprisoptimering och energilagring"
                                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                                <div class="absolute top-4 left-4">
                                    <span class="px-3 py-1.5 rounded-md bg-elorange text-white text-xs font-bold font-display uppercase tracking-wider shadow">
                                        50% Grön Teknik
                                    </span>
                                </div>
                                <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between">
                                    <div>
                                        <p class="text-xs uppercase font-bold text-slate-300 font-display tracking-wider">Energilagring</p>
                                        <h3 class="text-xl font-bold text-white font-display">Sigenergy EC Batteri</h3>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-xs text-slate-300 block">Från endast</span>
                                        <span class="text-2xl sm:text-3xl font-extrabold text-elblue font-display">65 000:-</span>
                                    </div>
                                </div>
                            </div>

                            {/* Innehåll & Sammanfattning */}
                            <div class="p-6 space-y-5">
                                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
                                    <div class="flex items-center justify-between mb-2">
                                        <h4 class="text-base font-bold text-slate-900 font-display flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-elorange"></span>
                                            Sigenergy EC 10kW System
                                        </h4>
                                        <span class="font-bold text-slate-900 font-display text-sm">Från 65 000 kr</span>
                                    </div>
                                    <p class="text-xs text-slate-600 mb-3">
                                        Komplett system för energifrihet – fungerar med eller utan befintliga solceller.
                                    </p>
                                    <ul class="text-xs text-slate-700 space-y-2">
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Sigenergy EC 10kW</strong> hybrid-enhet</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>15 kWh batterilagring</strong> (modulärt och säkert)</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>AI Spotprisoptimering:</strong> Ladda billigt, använd dyrt</span>
                                        </li>
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-1.5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span><strong>Standardinstallation:</strong> Skyddskomponenter & driftsättning</span>
                                        </li>
                                    </ul>
                                </div>

                                <div class="p-3.5 rounded-xl bg-blue-50/70 border border-blue-200/80 text-xs text-blue-950 space-y-1">
                                    <p class="font-bold font-display text-elblue">🔋 Smart effekttoppskapning</p>
                                    <p class="text-slate-600 text-[11px] leading-relaxed">
                                        Skydda dig mot framtida effekttariffer och höga elpristoppar direkt via appen.
                                    </p>
                                </div>
                            </div>
                        </div>

                        {/* Kort CTA */}
                        <div class="p-6 pt-0">
                            <button
                                type="button"
                                data-package="Endast Batterilager - Sigenergy 15kWh"
