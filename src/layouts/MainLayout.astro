---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
    robots?: string;
}

const { title, description, image, robots } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site || "https://elprojekt.nu";

// SEO defaults
const siteTitle = "ELPROJEKT";
const fullTitle = `${title} | ${siteTitle}`;
const defaultDescription =
    "Lokal elektriker i Tjörn, Orust & Stenungsund. Personlig service och moderna lösningar. Elinstallationer, laddboxar, solceller & batterier. Starta ditt nästa Elprojekt nu!";
const metaDescription = description || defaultDescription;
const canonicalURL = new URL(
    Astro.url.pathname,
    siteUrl,
);
const ogImage = new URL(
    image || `${base}images/og-image.jpeg`,
    siteUrl,
).toString();
const robotsContent = robots || "index, follow";

// LocalBusiness structured data for local SEO
const localBusinessSchema = {
    "@context": "https://schema.org",
    "@type": "Electrician",
    name: "ELPROJEKT",
    legalName: "Elprojekt i Uddevalla AB",
    taxID: "559557-0895",
    description: defaultDescription,
    url: "https://elprojekt.nu",
    telephone: "+46 70 332 56 55",
    email: "alex@elprojekt.nu",
    logo: new URL(`${base}favicon.svg`, siteUrl).toString(),
    address: {
        "@type": "PostalAddress",
        streetAddress: "Friggavägen 6",
        postalCode: "451 76",
        addressLocality: "Uddevalla",
        addressCountry: "SE",
    },
    areaServed: [
        { "@type": "City", name: "Tjörn" },
        { "@type": "City", name: "Orust" },
        { "@type": "City", name: "Stenungsund" },
        { "@type": "City", name: "Uddevalla" },
        { "@type": "City", name: "Kungälv" },
    ],
    serviceType: [
        "Elinstallation",
        "Laddbox",
        "Solceller",
        "Batterilagring",
        "Smarta hem",
        "Elservice",
        "Felsökning el",
        "Elcentral",
        "Underhåll el",
        "Nybyggnation",
        "Renovering",
        "Centralbyte",
    ],
    priceRange: "$$",
    aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "5.0",
        reviewCount: "5"
    },
};
---

<!doctype html>
<html lang="sv" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{fullTitle}</title>
        <meta name="description" content={metaDescription} />
        <ViewTransitions />

        <!-- Canonical URL & Language -->
        <link rel="canonical" href={canonicalURL.toString()} />
        <link rel="alternate" hreflang="sv-SE" href={canonicalURL.toString()} />
        <link
            rel="alternate"
            hreflang="x-default"
            href={canonicalURL.toString()}
        />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.toString()} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={fullTitle} />
        <meta property="og:locale" content="sv_SE" />
        <meta property="og:site_name" content={siteTitle} />

        <meta name="theme-color" content="#ffffff" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Additional SEO -->
        <meta name="robots" content={robotsContent} />
        <meta name="author" content="ELPROJEKT" />
        <meta name="geo.region" content="SE-O" />
        <meta name="geo.placename" content="Stenungsund" />

        <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />

        <!-- Preload Bank Gothic Light for faster loading -->
        <link
            rel="preload"
            href={base + "fonts/bank-gothic-light.woff2"}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <!-- Google Fonts: Inter (Non-blocking) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <!-- Structured Data (JSON-LD) -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(localBusinessSchema)}
        />

        <!-- Umami Analytics -->
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="fb44f7ca-22ca-4dc5-a8bb-24d955d307db"
            data-domains="elprojekt.nu,www.elprojekt.nu"
        ></script>
    </head>
    <body
        class="font-sans text-slate-700 antialiased bg-slate-50 selection:bg-elblue selection:text-white overflow-x-hidden"
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-elblue focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:text-sm focus:font-bold"
        >
            Hoppa till innehåll
        </a>
        <slot />
    </body>
</html>
